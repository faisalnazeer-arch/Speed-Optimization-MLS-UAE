{% doc %}
  @prompt
    need circular collection slider with image upload option and width options as well
    
    with also collection names options font size options as well, title option of section as well increase collection items, item width with mobile and desktop seperately

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-slider-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    padding: 20px 0;
  }

  .ai-collection-slider-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    position: relative;
  }

  .ai-collection-slider-title-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    margin-bottom: {{ block.settings.title_margin_bottom }}px;
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: {{ block.settings.title_font_weight }};
    margin-top: 0;
  }

  .ai-collection-slider-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    border-radius: 12px;
  }

  .ai-collection-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.3s ease;gap: {{ block.settings.item_gap }}px;
  }

  .ai-collection-item-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.item_width_desktop }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    cursor: pointer;
    transition: transform 0.3s ease;}

  .ai-collection-item-{{ ai_gen_id }}:hover {
    transform: scale({{ block.settings.hover_scale }});
  }

  .ai-collection-image-container-{{ ai_gen_id }} {
    width: {{ block.settings.item_width_desktop }}px;
    height: {{ block.settings.item_width_desktop }}px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 12px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.placeholder_bg_color }};}

  .ai-collection-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  .ai-collection-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.font_weight }};
    margin: 0;
    word-wrap: break-word;
    max-width: {{ block.settings.item_width_desktop }}px;
  }

  .ai-collection-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: {{ block.settings.nav_bg_color }};
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .ai-collection-nav-{{ ai_gen_id }}:hover {
    background: {{ block.settings.nav_hover_color }};
  }

  .ai-collection-nav-prev-{{ ai_gen_id }} {
    left: -20px;
  }

  .ai-collection-nav-next-{{ ai_gen_id }} {
    right: -20px;
  }

  .ai-collection-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.nav_icon_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-collection-item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.item_width_mobile }}px;
    }

    .ai-collection-image-container-{{ ai_gen_id }} {
      width: {{ block.settings.item_width_mobile }}px;
      height: {{ block.settings.item_width_mobile }}px;
    }

    .ai-collection-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
      max-width: {{ block.settings.item_width_mobile }}px;
    }

    .ai-collection-nav-{{ ai_gen_id }} {
      display: none;
    }

    .ai-collection-slider-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size_mobile }}px;
    }

    .ai-collection-slider-track-{{ ai_gen_id }} {
      gap: {{ block.settings.item_gap_mobile }}px;
    }
  }
{% endstyle %}<collection-slider-{{ ai_gen_id }}
  class="ai-collection-slider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-slider-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <h2 class="ai-collection-slider-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
    {% endif %}

    <div class="ai-collection-slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-collection-slider-track-{{ ai_gen_id }}">
        {% for i in (1..15) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign image_key = 'image_' | append: i
            assign collection = block.settings[collection_key]
            assign custom_image = block.settings[image_key]
          %}

          {% if collection != blank %}
            <div class="ai-collection-item-{{ ai_gen_id }}">
              <a href="{{ collection.url }}" class="ai-collection-link-{{ ai_gen_id }}">
                <div class="ai-collection-image-container-{{ ai_gen_id }}">
                  {% if custom_image != blank %}
                    <img
                      src="{{ custom_image | image_url: width: 300}}"
                      alt="{{ collection.title | escape }}"
                      class="ai-collection-image-{{ ai_gen_id }}"loading="lazy"
                      width="300"
                      height="300"
                    >
                  {% elsif collection.featured_image %}
                    <img
                      src="{{ collection.featured_image | image_url: width: 300 }}"
                      alt="{{ collection.title | escape }}"
                      class="ai-collection-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="300"
                      height="300"
                    >
                  {% else %}
                    <div class="ai-collection-placeholder-{{ ai_gen_id }}">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <h3 class="ai-collection-name-{{ ai_gen_id }}">{{ collection.title }}</h3>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <button class="ai-collection-nav-{{ ai_gen_id }} ai-collection-nav-prev-{{ ai_gen_id }}" aria-label="Previous">
      <svg viewBox="0 0 24 24">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
    </button>

    <button class="ai-collection-nav-{{ ai_gen_id }} ai-collection-nav-next-{{ ai_gen_id }}" aria-label="Next">
      <svg viewBox="0 0 24 24">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    </button>
  </div>
</collection-slider-{{ ai_gen_id }}><script>
  (function() {
    class CollectionSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.updateDimensions();
      }

      updateDimensions() {
        const isMobile = window.innerWidth <= 768;
        this.itemWidth = isMobile 
          ? {{ block.settings.item_width_mobile }} + {{ block.settings.item_gap_mobile }}
          : {{ block.settings.item_width_desktop }} + {{ block.settings.item_gap }};
        this.visibleItems = Math.floor({{ block.settings.container_width }} / this.itemWidth);
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-collection-slider-track-{{ ai_gen_id }}');
        this.items = this.querySelectorAll('.ai-collection-item-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-collection-nav-prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-collection-nav-next-{{ ai_gen_id }}');

        this.updateDimensions();
        this.maxIndex = Math.max(0, this.items.length - this.visibleItems);

        this.prevBtn.addEventListener('click', () => this.prev());
        this.nextBtn.addEventListener('click', () => this.next());

        window.addEventListener('resize', () => {
          this.updateDimensions();
          this.maxIndex = Math.max(0, this.items.length - this.visibleItems);this.currentIndex = Math.min(this.currentIndex, this.maxIndex);
          this.updateSlider();
        });

        this.updateNavigation();
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateSlider();
        }
      }

      next() {
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex++;
          this.updateSlider();
        }
      }

      updateSlider() {
        const translateX = -this.currentIndex * this.itemWidth;
        this.track.style.transform = `translateX(${translateX}px)`;
        this.updateNavigation();
      }

      updateNavigation() {
        this.prevBtn.style.opacity = this.currentIndex === 0 ? '0.5' : '1';
        this.nextBtn.style.opacity = this.currentIndex === this.maxIndex ? '0.5' : '1';
        this.prevBtn.disabled = this.currentIndex === 0;
        this.nextBtn.disabled = this.currentIndex === this.maxIndex;
      }
    }

    customElements.define('collection-slider-{{ ai_gen_id }}', CollectionSlider{{ ai_gen_id }});
  })();
</script>

