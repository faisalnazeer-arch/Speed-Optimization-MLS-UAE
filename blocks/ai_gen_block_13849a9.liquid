{% doc %}
  @prompt
    I want a small banner in above and in below banner there should be 3 buttons like classic, signature and economical
    
    
    I want all thing customizeable, I want small banner above buttons not text

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.section_gap }}px;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.section_bg_color }};
  }

  .ai-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.banner_height }}px;
    background-color: {{ block.settings.banner_bg_color }};
    border-radius: {{ block.settings.banner_border_radius }}px;
    border: {{ block.settings.banner_border_width }}px solid {{ block.settings.banner_border_color }};
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.banner_image_fit }};
    object-position: {{ block.settings.banner_image_position }};
  }

  .ai-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.banner_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 100px;
    opacity: 0.3;
  }

  .ai-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 12px;
    background-color: rgba(0, 0, 0, 0.7);
    color: white;
    font-size: 12px;
    border-radius: 4px;
    pointer-events: none;
  }

  .ai-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.banner_overlay_color }};
    opacity: {{ block.settings.banner_overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-banner-content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: {{ block.settings.banner_text_color }};
    z-index: 2;
  }

  .ai-banner-title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.banner_title_margin }}px 0;
    font-size: {{ block.settings.banner_title_size }}px;
    font-weight: {{ block.settings.banner_title_weight }};
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .ai-banner-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.banner_text_size }}px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .ai-buttons-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.buttons_gap }}px;
    justify-content: {{ block.settings.buttons_alignment }};
    flex-wrap: wrap;
  }

  .ai-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: {{ block.settings.button_border_width }}px solid;
    transition: all 0.3s ease;
    cursor: pointer;
    min-width: {{ block.settings.button_min_width }}px;
    text-align: center;
  }

  .ai-button-classic-{{ ai_gen_id }} {
    background-color: {{ block.settings.classic_bg_color }};
    color: {{ block.settings.classic_text_color }};
    border-color: {{ block.settings.classic_border_color }};
  }

  .ai-button-classic-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.classic_hover_bg_color }};
    color: {{ block.settings.classic_hover_text_color }};
    border-color: {{ block.settings.classic_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-button-signature-{{ ai_gen_id }} {
    background-color: {{ block.settings.signature_bg_color }};
    color: {{ block.settings.signature_text_color }};
    border-color: {{ block.settings.signature_border_color }};
  }

  .ai-button-signature-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.signature_hover_bg_color }};
    color: {{ block.settings.signature_hover_text_color }};
    border-color: {{ block.settings.signature_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-button-economical-{{ ai_gen_id }} {
    background-color: {{ block.settings.economical_bg_color }};
    color: {{ block.settings.economical_text_color }};
    border-color: {{ block.settings.economical_border_color }};
  }

  .ai-button-economical-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.economical_hover_bg_color }};
    color: {{ block.settings.economical_hover_text_color }};
    border-color: {{ block.settings.economical_hover_border_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-banner-{{ ai_gen_id }} {
      height: {{ block.settings.banner_height_mobile }}px;
    }

    .ai-banner-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.banner_title_size_mobile }}px;
    }

    .ai-banner-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.banner_text_size_mobile }}px;
    }

    .ai-buttons-container-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.mobile_layout }};
      gap: {{ block.settings.buttons_gap_mobile }}px;
    }

    .ai-button-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'column' %}
        width: 100%;
      {% endif %}
      padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
      font-size: {{ block.settings.button_font_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-banner-buttons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-banner-{{ ai_gen_id }}">
    {% if block.settings.banner_image %}
      <img
        src="{{ block.settings.banner_image | image_url: width: 1200 }}"
        alt="{{ block.settings.banner_image.alt | escape }}"
        class="ai-banner-image-{{ ai_gen_id }}"
        loading="lazy"
        width="{{ block.settings.banner_image.width }}"
        height="{{ block.settings.banner_image.height }}"
      >
    {% else %}
      <div class="ai-banner-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-banner-empty-state-{{ ai_gen_id }}">
          Add a banner image
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_overlay %}
      <div class="ai-banner-overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.banner_title != blank or block.settings.banner_text != blank %}
      <div class="ai-banner-content-{{ ai_gen_id }}">
        {% if block.settings.banner_title != blank %}
          <h2 class="ai-banner-title-{{ ai_gen_id }}">{{ block.settings.banner_title }}</h2>
        {% endif %}
        {% if block.settings.banner_text != blank %}
          <div class="ai-banner-text-{{ ai_gen_id }}">{{ block.settings.banner_text }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="ai-buttons-container-{{ ai_gen_id }}">
    <a href="{{ block.settings.classic_link }}" class="ai-button-{{ ai_gen_id }} ai-button-classic-{{ ai_gen_id }}">
      {{ block.settings.classic_text }}
    </a>
    <a href="{{ block.settings.signature_link }}" class="ai-button-{{ ai_gen_id }} ai-button-signature-{{ ai_gen_id }}">
      {{ block.settings.signature_text }}
    </a>
    <a href="{{ block.settings.economical_link }}" class="ai-button-{{ ai_gen_id }} ai-button-economical-{{ ai_gen_id }}">
      {{ block.settings.economical_text }}
    </a>
  </div>
</div>

