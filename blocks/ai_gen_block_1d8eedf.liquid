{% endstyle %}<product-range-tabs-{{ ai_gen_id }}
  class="ai-product-range-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-range-tabs-{{ ai_gen_id }}">
    {% if block.settings.tab_1_text != blank %}
      <button
        class="ai-product-range-tab-{{ ai_gen_id }} ai-product-range-tab-1-{{ ai_gen_id }} active"
        data-tab="1"
      >
        {{ block.settings.tab_1_text }}
      </button>
    {% endif %}

    {% if block.settings.tab_2_text != blank %}
      <button
        class="ai-product-range-tab-{{ ai_gen_id }} ai-product-range-tab-2-{{ ai_gen_id }}"
        data-tab="2"
      >
        {{ block.settings.tab_2_text }}
      </button>
    {% endif %}

    {% if block.settings.tab_3_text != blank %}
      <button
        class="ai-product-range-tab-{{ ai_gen_id }} ai-product-range-tab-3-{{ ai_gen_id }}"
        data-tab="3"
      >
        {{ block.settings.tab_3_text }}
      </button>
    {% endif %}
  </div>

  {% for tab_num in (1..3) %}
    {% liquid
      assign tab_text_key = 'tab_' | append: tab_num | append: '_text'
      assign tab_subtitle_key = 'tab_' | append: tab_num | append: '_subtitle'
      assign tab_button_text_key = 'tab_' | append: tab_num | append: '_button_text'
      assign tab_button_link_key = 'tab_' | append: tab_num | append: '_button_link'
      
      assign tab_text = block.settings[tab_text_key]
      assign tab_subtitle = block.settings[tab_subtitle_key]
      assign tab_button_text = block.settings[tab_button_text_key]
      assign tab_button_link = block.settings[tab_button_link_key]
    %}

    {% if tab_text != blank %}
      <div
        class="ai-product-range-content-{{ ai_gen_id }} {% if tab_num == 1 %}active{% endif %}"
        data-content="{{ tab_num }}"
      >
        <div class="ai-product-range-flags-section-{{ ai_gen_id }}">
          <div class="ai-product-range-flags-{{ ai_gen_id }}">
            {% for flag_num in (1..3) %}
              {% liquid
                assign flag_image_key = 'tab_' | append: tab_num | append: '_flag_' | append: flag_num | append: '_image'
                assign flag_link_key = 'tab_' | append: tab_num | append: '_flag_' | append: flag_num | append: '_link'
                assign flag_image = block.settings[flag_image_key]
                assign flag_link = block.settings[flag_link_key]
              %}

              {% if flag_link != blank %}
                <a href="{{ flag_link }}" class="ai-product-range-flag-item-{{ ai_gen_id }}">
              {% else %}
                <div class="ai-product-range-flag-item-{{ ai_gen_id }}">
              {% endif %}
                <div class="ai-product-range-flag-circle-{{ ai_gen_id }}">
                  {% if flag_image %}
                    <img
                      src="{{ flag_image | image_url: width: 160 }}"
                      alt="{{ flag_image.alt | escape }}"
                      class="ai-product-range-flag-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="{{ block.settings.flag_size }}"
                      height="{{ block.settings.flag_size }}"
                    >
                  {% else %}
                    <div class="ai-product-range-flag-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
              {% if flag_link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        {% if tab_subtitle != blank %}
          <div class="ai-product-range-subtitle-section-{{ ai_gen_id }}">
            <p class="ai-product-range-subtitle-{{ ai_gen_id }}">
              {{ tab_subtitle }}
            </p>
          </div>
        {% endif %}

        <div class="ai-product-range-features-{{ ai_gen_id }}">
          <div class="ai-product-range-features-grid-{{ ai_gen_id }}">
            {% for feature_num in (1..4) %}
              {% liquid
                assign feature_key = 'tab_' | append: tab_num | append: '_feature_' | append: feature_num
                assign feature_text = block.settings[feature_key]
              %}
              {% if feature_text != blank %}
                <div class="ai-product-range-features-item-{{ ai_gen_id }}">
                  <span class="ai-product-range-bullet-{{ ai_gen_id }}"></span>
                  {{ feature_text }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        {% if tab_button_text != blank %}
          {% if tab_button_link != blank %}<a href="{{ tab_button_link }}" class="ai-product-range-button-{{ ai_gen_id }}">
              {{ tab_button_text }}
            </a>
          {% else %}
            <button class="ai-product-range-button-{{ ai_gen_id }}">
              {{ tab_button_text }}
            </button>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</product-range-tabs-{{ ai_gen_id }}>

<script type="lazyload" >
  (function() {
    class ProductRangeTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-product-range-tab-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-product-range-content-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const tabNumber = tab.getAttribute('data-tab');
            this.switchTab(tabNumber);
          });
        });
      }

      switchTab(tabNumber) {
        this.tabs.forEach((tab) => {
          tab.classList.remove('active');
        });

        this.contents.forEach((content) => {
          content.classList.remove('active');
        });

        const activeTab = this.querySelector(`[data-tab="${tabNumber}"]`);
        const activeContent = this.querySelector(`[data-content="${tabNumber}"]`);

        if (activeTab) {
          activeTab.classList.add('active');
        }

        if (activeContent) {
          activeContent.classList.add('active');
        }
      }
    }

    customElements.define('product-range-tabs-{{ ai_gen_id }}', ProductRangeTabs{{ ai_gen_id }});
  })();
</script>

