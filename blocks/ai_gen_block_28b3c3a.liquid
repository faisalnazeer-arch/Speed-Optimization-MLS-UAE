      <div class="ai-product-range__sub-tabs-{{ ai_gen_id }}">
        <button
          class="ai-product-range__sub-tab-{{ ai_gen_id }} active"
          data-sub-tab="economic-1"
          data-parent="economic"
        >
          {{ section.settings.economic_sub1_title }}
        </button>
        <button
          class="ai-product-range__sub-tab-{{ ai_gen_id }}"
          data-sub-tab="economic-2"
          data-parent="economic"
        >
          {{ section.settings.economic_sub2_title }}
        </button>
        <button
          class="ai-product-range__sub-tab-{{ ai_gen_id }}"
