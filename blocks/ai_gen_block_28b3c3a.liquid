</product-range-tabs-{{ ai_gen_id }}><script>
  (function() {
    class ProductRangeTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.mainTabs = this.querySelectorAll('.ai-product-range__main-tab-{{ ai_gen_id }}');
        this.mainPanels = this.querySelectorAll('.ai-product-range__main-panel-{{ ai_gen_id }}');
        this.subTabs = this.querySelectorAll('.ai-product-range__sub-tab-{{ ai_gen_id }}');
        this.subPanels = this.querySelectorAll('.ai-product-range__sub-panel-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.mainTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const targetPanel = tab.dataset.mainTab;
            this.switchMainTab(targetPanel);
          });
        });

        this.subTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const targetPanel = tab.dataset.subTab;
            const parent = tab.dataset.parent;
            this.switchSubTab(targetPanel, parent);
          });
        });
      }

      switchMainTab(targetPanel) {
        this.mainTabs.forEach((tab) => {
          tab.classList.remove('active');
          tab.setAttribute('aria-selected', 'false');
        });

        this.mainPanels.forEach((panel) => {
          panel.classList.remove('active');
        });

        const activeTab = this.querySelector(`[data-main-tab="${targetPanel}"]`);
        const activePanel = this.querySelector(`[data-main-panel="${targetPanel}"]`);

        if (activeTab && activePanel) {
          activeTab.classList.add('active');
          activeTab.setAttribute('aria-selected', 'true');
          activePanel.classList.add('active');

          const firstSubTab = activePanel.querySelector('.ai-product-range__sub-tab-{{ ai_gen_id }}');
          if (firstSubTab) {
            const firstSubTabId = firstSubTab.dataset.subTab;
            this.switchSubTab(firstSubTabId, targetPanel);
          }
        }
      }

      switchSubTab(targetPanel, parent) {
        const parentPanel = this.querySelector(`[data-main-panel="${parent}"]`);
        if (!parentPanel) return;

        const parentSubTabs = parentPanel.querySelectorAll('.ai-product-range__sub-tab-{{ ai_gen_id }}');
        const parentSubPanels = parentPanel.querySelectorAll('.ai-product-range__sub-panel-{{ ai_gen_id }}');

        parentSubTabs.forEach((tab) => {
          tab.classList.remove('active');
        });

        parentSubPanels.forEach((panel) => {
          panel.classList.remove('active');
        });

        const activeSubTab = parentPanel.querySelector(`[data-sub-tab="${targetPanel}"]`);
        const activeSubPanel = this.querySelector(`[data-sub-panel="${targetPanel}"]`);

        if (activeSubTab && activeSubPanel) {
          activeSubTab.classList.add('active');
          activeSubPanel.classList.add('active');
        }
      }
    }

    customElements.define('product-range-tabs-{{ ai_gen_id }}', ProductRangeTabs{{ ai_gen_id }});
  })();
</script>

