      <div class="ai-product-range__flags-{{ ai_gen_id }}">
        {% if section.settings.flag_1_image %}
          <a href="{{ section.settings.flag_1_link | default: '#' }}" class="ai-product-range__flag-{{ ai_gen_id }}">
