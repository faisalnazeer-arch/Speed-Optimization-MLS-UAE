          data-parent="economic"
        >
          {{ section.settings.economic_sub3_title }}
        </button>
      </div>

      <div class="ai-product-range__sub-panel-{{ ai_gen_id }} active" data-sub-panel="economic-1">
        <div class="ai-product-range__carousel-{{ ai_gen_id }}">
          {% if section.settings.economic_sub1_collection != blank %}
            <div class="ai-product-range__products-{{ ai_gen_id }}">
              {% for product in section.settings.economic_sub1_collection.products limit: 8 %}
                <div class="ai-product-range__product-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 300 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-product-range__product-image-{{ ai_gen_id }}"
                      loading="lazy"
                    >
                  {% else %}
                    <div class="ai-product-range__product-image-{{ ai_gen_id }}" style="background-color: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                  <h4 class="ai-product-range__product-title-{{ ai_gen_id }}">{{ product.title }}</h4>
                  <p class="ai-product-range__product-price-{{ ai_gen_id }}">{{ product.price | money }}</p>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <div class="ai-product-range__empty-collection-{{ ai_gen_id }}">
              Select a collection to display products
            </div>
          {% endif %}
        </div>
      </div>

