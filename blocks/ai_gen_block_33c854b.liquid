<script type="lazyload">
  (function() {
    class ProductRangeTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupMainTabs();
        this.setupSubTabs();
      }

      setupMainTabs() {
        const mainTabs = this.querySelectorAll('.ai-product-range-main-tab-{{ ai_gen_id }}');
        const mainContents = this.querySelectorAll('.ai-product-range-main-tab-content-{{ ai_gen_id }}');

        mainTabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const targetTab = tab.dataset.mainTab;

            mainTabs.forEach(t => t.classList.remove('active'));
            mainContents.forEach(c => c.classList.remove('active'));

            tab.classList.add('active');
            const targetContent = this.querySelector(`[data-main-content="${targetTab}"]`);
            if (targetContent) {
              targetContent.classList.add('active');
              const firstSubTab = targetContent.querySelector('.ai-product-range-sub-tab-{{ ai_gen_id }}');
              const firstSubContent = targetContent.querySelector('.ai-product-range-sub-tab-content-{{ ai_gen_id }}');
              if (firstSubTab && firstSubContent) {
                targetContent.querySelectorAll('.ai-product-range-sub-tab-{{ ai_gen_id }}').forEach(st => st.classList.remove('active'));
                targetContent.querySelectorAll('.ai-product-range-sub-tab-content-{{ ai_gen_id }}').forEach(sc => sc.classList.remove('active'));
                firstSubTab.classList.add('active');
                firstSubContent.classList.add('active');
              }
            }
          });
        });
      }

      setupSubTabs() {
        const subTabs = this.querySelectorAll('.ai-product-range-sub-tab-{{ ai_gen_id }}');

        subTabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const targetSubTab = tab.dataset.subTab;
            const subIndex = tab.dataset.subIndex;
            const parentContent = tab.closest('.ai-product-range-main-tab-content-{{ ai_gen_id }}');

            if (parentContent) {
              const siblingSubTabs = parentContent.querySelectorAll('.ai-product-range-sub-tab-{{ ai_gen_id }}');
              const siblingSubContents = parentContent.querySelectorAll('.ai-product-range-sub-tab-content-{{ ai_gen_id }}');

              siblingSubTabs.forEach(st => st.classList.remove('active'));
              siblingSubContents.forEach(sc => sc.classList.remove('active'));

              tab.classList.add('active');
              const targetContent = parentContent.querySelector(`[data-sub-content="${targetSubTab}-${subIndex}"]`);
              if (targetContent) {
                targetContent.classList.add('active');
              }
            }
          });
        });
      }
    }

    customElements.define('product-range-tabs-{{ ai_gen_id }}', ProductRangeTabs{{ ai_gen_id }});
  })();
</script>

