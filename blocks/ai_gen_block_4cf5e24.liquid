{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-vertical-tabs-{{ ai_gen_id }} {
    {% if block.settings.full_width %}
      width: 100%;
      max-width: none;
    {% else %}
      max-width: {{ block.settings.section_width }}px;
    {% endif %}
    margin: 0 auto;
    padding: 20px;
    {% if block.settings.section_border_width > 0 %}
      border: {{ block.settings.section_border_width }}px solid {{ block.settings.section_border_color }};
    {% endif %}
    border-radius: {{ block.settings.section_border_radius }}px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 500px;
  }

  .ai-vertical-tabs__container-{{ ai_gen_id }} {
    display: flex;
    gap: 30px;
    border: {{ block.settings.content_border_width }}px solid {{ block.settings.content_border_color }};
    border-radius: {{ block.settings.content_border_radius }}px;
    overflow: hidden;
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
  }

  .ai-vertical-tabs__nav-{{ ai_gen_id }} {
    flex: 0 0 300px;
    background-color: {{ block.settings.tabs_bg_color }};
    padding: 20px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-vertical-tabs__tab-{{ ai_gen_id }} {
    display: block;
    width: 80%;
    text-align: center;
    padding: 15px 20px;
    border: {{ block.settings.tab_border_width }}px solid {{ block.settings.tab_border_color }};
    border-radius: {{ block.settings.tab_border_radius }}px;
    background: none;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-bottom: 10px;
    font-size: 16px;
    font-weight: 500;
  }

  .ai-vertical-tabs__tab-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-vertical-tabs__tab-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .ai-vertical-tabs__tab-1-{{ ai_gen_id }} {
    background-color: {{ block.settings.tab_1_bg_color }};color: {{ block.settings.tab_1_text_color }};
  }

  .ai-vertical-tabs__tab-1-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.tab_1_active_bg_color }};
    color: {{ block.settings.tab_1_active_text_color }};
