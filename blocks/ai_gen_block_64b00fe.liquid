    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store name",
      "default": "MLS Gourmet Butchery - Abu Dhabi"
    },
    {
      "type": "text",
      "id": "store_subtitle",
      "label": "Subtitle",
      "default": "Meat Market, Mushrif Mall, Abu Dhabi"
    },
    {
      "type": "textarea",
