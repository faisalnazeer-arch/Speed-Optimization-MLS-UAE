{% doc %}
  @prompt
    need a text editor with all formating options h1 h2 h3b h4 h5 paragraph and als bold italic and bullet points pure text editor just like page description editor
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-rich-text-editor-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} {
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} h1,
  .ai-rich-text-editor__content-{{ ai_gen_id }} h2,
  .ai-rich-text-editor__content-{{ ai_gen_id }} h3,
  .ai-rich-text-editor__content-{{ ai_gen_id }} h4,
  .ai-rich-text-editor__content-{{ ai_gen_id }} h5 {
    color: {{ block.settings.heading_color }};
    margin-top: 0;
    margin-bottom: 16px;
    font-weight: 700;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} h1 {
    font-size: 2.5em;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} h2 {
    font-size: 2em;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} h3 {
    font-size: 1.75em;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} h4 {
    font-size: 1.5em;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} h5 {
    font-size: 1.25em;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} p {
    margin-top: 0;
    margin-bottom: 16px;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} strong {
    font-weight: 700;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} em {
    font-style: italic;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} ul,
  .ai-rich-text-editor__content-{{ ai_gen_id }} ol {
    margin-top: 0;
    margin-bottom: 16px;
    padding-left: 24px;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} ul {
    list-style-type: disc;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} ol {
    list-style-type: decimal;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} li:last-child {
    margin-bottom: 0;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-rich-text-editor__content-{{ ai_gen_id }} a:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-rich-text-editor-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-rich-text-editor__content-{{ ai_gen_id }} h1 {
      font-size: 2em;
    }

    .ai-rich-text-editor__content-{{ ai_gen_id }} h2 {
      font-size: 1.75em;
    }

    .ai-rich-text-editor__content-{{ ai_gen_id }} h3 {
      font-size: 1.5em;
    }

    .ai-rich-text-editor__content-{{ ai_gen_id }} h4 {
      font-size: 1.25em;
    }

    .ai-rich-text-editor__content-{{ ai_gen_id }} h5 {
      font-size: 1.1em;
    }
  }
{% endstyle %}

<div class="ai-rich-text-editor-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-rich-text-editor__content-{{ ai_gen_id }}">
    {% if block.settings.content != blank %}
      {{ block.settings.content }}
    {% else %}
      <p>Add your content using the rich text editor. You can format text with headings, bold, italic, and bullet points.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Rich text editor",
  "settings": [
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Use the rich text editor to format your content with headings, paragraphs, bold, italic, and lists.</p>"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Rich text editor"
    }
  ]
}
{% endschema %}
