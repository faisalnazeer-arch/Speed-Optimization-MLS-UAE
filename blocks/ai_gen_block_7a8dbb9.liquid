      <div class="ai-vertical-tabs__tab-header-{{ ai_gen_id }}">
        <div class="ai-vertical-tabs__icon-circle-{{ ai_gen_id }}" style="background-color: {{ block.settings.tab1_color }};">
          <div class="ai-vertical-tabs__arrow-icon-{{ ai_gen_id }}">
