<script type="lazyload" >
  (function() {
    class VerticalTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-vertical-tabs__tab-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          const header = tab.querySelector('.ai-vertical-tabs__tab-header-{{ ai_gen_id }}');
          header.addEventListener('click', () => {
            this.toggleTab(tab);
          });
        });
      }

      toggleTab(targetTab) {
        const isActive = targetTab.classList.contains('active');
        
        this.tabs.forEach((tab) => {
          tab.classList.remove('active');
        });

        if (!isActive) {
          targetTab.classList.add('active');
        }
      }
    }

    customElements.define('vertical-tabs-{{ ai_gen_id }}', VerticalTabs{{ ai_gen_id }});
  })();
</script>

