              <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
            </svg>
          </div>
        </div>
        <h3 class="ai-vertical-tabs__tab-title-{{ ai_gen_id }}" style="color: {{ block.settings.tab1_color }};">
          {{ block.settings.tab1_title }}
        </h3>
      </div>
      <div class="ai-vertical-tabs__tab-content-{{ ai_gen_id }}">
        {% if block.settings.tab1_subtitle != blank %}
          <p class="ai-vertical-tabs__subtitle-{{ ai_gen_id }}">{{ block.settings.tab1_subtitle }}</p>
        {% endif %}
        {% if block.settings.tab1_content != blank %}
          <ul class="ai-vertical-tabs__bullet-list-{{ ai_gen_id }}">
            {% assign items = block.settings.tab1_content | split: ',' %}
            {% for item in items %}
              {% assign trimmed_item = item | strip %}
              {% if trimmed_item != blank %}
                <li class="ai-vertical-tabs__bullet-item-{{ ai_gen_id }}">
                  <div class="ai-vertical-tabs__bullet-icon-{{ ai_gen_id }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="{{ block.settings.tab1_color }}">
                      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </svg>
                  </div>
                  {{ trimmed_item }}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
        {% if block.settings.tab1_button_text != blank %}
          <a 
            href="{{ block.settings.tab1_button_link }}" 
            class="ai-vertical-tabs__view-all-button-{{ ai_gen_id }}"
            style="color: {{ block.settings.tab1_color }}; border-color: {{ block.settings.tab1_color }};"
          >
            {{ block.settings.tab1_button_text }}
