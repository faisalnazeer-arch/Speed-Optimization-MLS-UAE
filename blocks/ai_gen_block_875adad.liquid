{% doc %}
  @prompt
    {
      "name": "Collection Filters",
      "settings": [
        {
          "type": "text",
          "id": "filter_section_title",
          "label": "Filter Section Title",
          "default": "Filter Products"
        },
        {
          "type": "checkbox",
          "id": "show_filters",
          "label": "Enable Filters",
          "default": true
        },
        {
          "type": "header",
          "content": "Filter Options"
        },
        {
          "type": "checkbox",
          "id": "show_category_filter",
          "label": "Show Category Filter",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_price_filter",
          "label": "Show Price Filter",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_color_filter",
          "label": "Show Color Filter",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_size_filter",
          "label": "Show Size Filter",
          "default": false
        }
      ],
      "blocks": [
        {
          "type": "filter_value",
          "name": "Filter Value",
          "settings": [
            {
              "type": "select",
              "id": "filter_type",
              "label": "Filter Type",
              "options": [
                { "value": "category", "label": "Category" },
                { "value": "price", "label": "Price" },
                { "value": "color", "label": "Color" },
                { "value": "size", "label": "Size" }
              ],
              "default": "category"
            },
            {
              "type": "text",
              "id": "filter_value",
              "label": "Filter Value",
              "info": "E.g., 'Shirts', '$0-$50', 'Red', 'Medium'"
            }
          ]
        }
      ],
      "presets": [
        {
          "name": "Collection Filters",
          "settings": {
            "filter_section_title": "Filter Products",
            "show_filters": true,
            "show_category_filter": true,
            "show_price_filter": true,
            "show_color_filter": false,
            "show_size_filter": false
          }
        }
      ]
    }
    
    collection buttons that automatically appllied when clicked

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-filters-{{ ai_gen_id }} {
    padding: 24px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    margin-bottom: 32px;
  }

  .ai-collection-filters__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 20px 0;
    font-weight: 600;
  }

  .ai-collection-filters__container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .ai-collection-filters__group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 200px;
  }

  .ai-collection-filters__group-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-collection-filters__buttons-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ai-collection-filters__button-{{ ai_gen_id }} {
    padding: 8px 16px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: 2px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }

  .ai-collection-filters__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-collection-filters__button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.button_active_bg_color }};
    color: {{ block.settings.button_active_text_color }};
    border-color: {{ block.settings.button_active_border_color }};
  }

  .ai-collection-filters__clear-{{ ai_gen_id }} {
    margin-top: 16px;
    padding: 10px 20px;
    background-color: transparent;
    color: {{ block.settings.clear_button_color }};
    border: 1px solid {{ block.settings.clear_button_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .ai-collection-filters__clear-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.clear_button_color }};
    color: {{ block.settings.background_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-collection-filters__container-{{ ai_gen_id }} {
      flex-direction: column;}

    .ai-collection-filters__group-{{ ai_gen_id }} {
      min-width: auto;
    }
  }
{% endstyle %}

<collection-filters-{{ ai_gen_id }}
  class="ai-collection-filters-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.show_filters %}
    {% if block.settings.filter_section_title != blank %}
      <h3 class="ai-collection-filters__title-{{ ai_gen_id }}">{{ block.settings.filter_section_title }}</h3>
    {% endif %}

    <div class="ai-collection-filters__container-{{ ai_gen_id }}">
      {% if block.settings.show_category_filter %}
        <div class="ai-collection-filters__group-{{ ai_gen_id }}">
          <h4 class="ai-collection-filters__group-title-{{ ai_gen_id }}">Category</h4>
          <div class="ai-collection-filters__buttons-{{ ai_gen_id }}">
            {% assign category_filters = block.settings.category_filters | split: ',' %}
            {% for category in category_filters %}
              {% assign trimmed_category = category | strip %}
              {% if trimmed_category != blank %}
                <button
                  class="ai-collection-filters__button-{{ ai_gen_id }}"
                  data-filter-type="category"
                  data-filter-value="{{ trimmed_category | downcase | handle }}"
                >
                  {{ trimmed_category }}
                </button>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_price_filter %}
        <div class="ai-collection-filters__group-{{ ai_gen_id }}">
          <h4 class="ai-collection-filters__group-title-{{ ai_gen_id }}">Price Range</h4>
          <div class="ai-collection-filters__buttons-{{ ai_gen_id }}">
            {% assign price_filters = block.settings.price_filters | split: ',' %}
            {% for price in price_filters %}
              {% assign trimmed_price = price | strip %}
              {% if trimmed_price != blank %}
                <button
                  class="ai-collection-filters__button-{{ ai_gen_id }}"
                  data-filter-type="price"
                  data-filter-value="{{ trimmed_price | handle }}"
                >
                  {{ trimmed_price }}
                </button>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_color_filter %}
        <div class="ai-collection-filters__group-{{ ai_gen_id }}">
          <h4 class="ai-collection-filters__group-title-{{ ai_gen_id }}">Color</h4>
          <div class="ai-collection-filters__buttons-{{ ai_gen_id }}">
            {% assign color_filters = block.settings.color_filters | split: ',' %}
            {% for color in color_filters %}
              {% assign trimmed_color = color | strip %}
              {% if trimmed_color != blank %}
                <button
                  class="ai-collection-filters__button-{{ ai_gen_id }}"
                  data-filter-type="color"
                  data-filter-value="{{ trimmed_color | downcase | handle }}"
                >
                  {{ trimmed_color }}
                </button>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_size_filter %}
        <div class="ai-collection-filters__group-{{ ai_gen_id }}">
          <h4 class="ai-collection-filters__group-title-{{ ai_gen_id }}">Size</h4>
          <div class="ai-collection-filters__buttons-{{ ai_gen_id }}">
            {% assign size_filters = block.settings.size_filters | split: ',' %}
            {% for size in size_filters %}
              {% assign trimmed_size = size | strip %}
              {% if trimmed_size != blank %}
                <button
                  class="ai-collection-filters__button-{{ ai_gen_id }}"
                  data-filter-type="size"
                  data-filter-value="{{ trimmed_size | downcase | handle }}"
                >
                  {{ trimmed_size }}
                </button>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>

    <button class="ai-collection-filters__clear-{{ ai_gen_id }}" id="clear-filters-{{ ai_gen_id }}">
      Clear All Filters
    </button>
  {% endif %}
</collection-filters-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionFilters{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.activeFilters = new Set();
      }

      connectedCallback() {
        this.filterButtons = this.querySelectorAll('.ai-collection-filters__button-{{ ai_gen_id }}');
        this.clearButton = this.querySelector('#clear-filters-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.filterButtons.forEach(button => {
          button.addEventListener('click', (e) => {
            this.handleFilterClick(e.target);
          });
        });

        this.clearButton.addEventListener('click', () => {
          this.clearAllFilters();
        });
      }

      handleFilterClick(button) {
        const filterType = button.dataset.filterType;
        const filterValue = button.dataset.filterValue;
        const filterId = `${filterType}-${filterValue}`;

        if (this.activeFilters.has(filterId)) {
          this.activeFilters.delete(filterId);
          button.classList.remove('active');
        } else {
          this.activeFilters.add(filterId);
          button.classList.add('active');
        }

        this.applyFilters();
      }

      clearAllFilters() {
        this.activeFilters.clear();
        this.filterButtons.forEach(button => {
          button.classList.remove('active');
        });
        this.applyFilters();
      }

      applyFilters() {
        const products = document.querySelectorAll('[data-product-item]');
        
        if (this.activeFilters.size === 0) {
          products.forEach(product => {
            product.style.display = '';
          });
          return;
        }

        products.forEach(product => {
          let shouldShow = true;
          
          for (const filterId of this.activeFilters) {
            const [filterType, filterValue] = filterId.split('-');
            
            if (!this.productMatchesFilter(product, filterType, filterValue)) {
              shouldShow = false;
              break;
            }
          }

          product.style.display = shouldShow ? '' : 'none';
        });
      }

      productMatchesFilter(product, filterType, filterValue) {
        switch (filterType) {
          case 'category':
            const productType = product.dataset.productType;
            return productType && productType.toLowerCase().includes(filterValue);
          
          case 'price':
            const productPrice = parseFloat(product.dataset.productPrice);
            return this.priceInRange(productPrice, filterValue);
          
          case 'color':
            const productTags = product.dataset.productTags;
            return productTags && productTags.toLowerCase().includes(filterValue);
          
          case 'size':
            const productSizes = product.dataset.productSizes;
            return productSizes && productSizes.toLowerCase().includes(filterValue);
          
          default:
            return true;
        }
      }

      priceInRange(price, rangeValue) {
        if (rangeValue.includes('under')) {
          const maxPrice = parseFloat(rangeValue.replace(/[^0-9.]/g, ''));
          return price <= maxPrice;
        }
        
        if (rangeValue.includes('over')) {
          const minPrice = parseFloat(rangeValue.replace(/[^0-9.]/g, ''));
          return price >= minPrice;
        }
        
        if (rangeValue.includes('-')) {
          const [min, max] = rangeValue.split('-').map(val => parseFloat(val.replace(/[^0-9.]/g, '')));
          return price >= min && price <= max;
        }
        
        return true;
      }
    }

    customElements.define('collection-filters-{{ ai_gen_id }}', CollectionFilters{{ ai_gen_id }});
  })();
</script>

