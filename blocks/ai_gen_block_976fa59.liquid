    {
      "type": "header",
      "content": "Bottom right image"
    },
    {
      "type": "image_picker",
      "id": "bottom_right_image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "bottom_right_link",
      "label": "Link"
    },
    {
      "type": "select",
