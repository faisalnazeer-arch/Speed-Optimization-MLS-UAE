{% doc %}
  @prompt
    need media grid with 3 media images on top one landscape and on below 2 banners square but need to be optimized for both devic views desktop and mobile also link adding option 
    
    one top
    2 below
    
    , need sizing options for all imagee, neeed width for mobile as well and also need heading for section as wel
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-media-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
  }

  .ai-media-grid-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.mobile_width_percent }}%;
    margin: 0 auto;
  }

  .ai-media-grid-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-media-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.gap }}px;
    width: 100%;
  }

  .ai-media-grid-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    width: 100%;
  }

  .ai-media-grid-item-{{ ai_gen_id }} a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-media-grid-top-{{ ai_gen_id }} {
    aspect-ratio: {{ block.settings.top_aspect_ratio }};
    width: 100%;
  }

  .ai-media-grid-bottom-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.gap }}px;
  }

  .ai-media-grid-bottom-item-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-media-grid-bottom-left-{{ ai_gen_id }} {
    aspect-ratio: {{ block.settings.bottom_left_aspect_ratio }};
  }

  .ai-media-grid-bottom-right-{{ ai_gen_id }} {
    aspect-ratio: {{ block.settings.bottom_right_aspect_ratio }};
  }

  .ai-media-grid-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    display: block;
    transition: transform 0.3s ease;
  }

  .ai-media-grid-item-{{ ai_gen_id }} a:hover img {
    transform: scale(1.05);
  }

  .ai-media-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-media-grid-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-media-grid-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (min-width: 750px) {
    .ai-media-grid-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
    }

    .ai-media-grid-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 1.2 }}px;
    }
  }
{% endstyle %}

<media-grid-{{ ai_gen_id }}
  class="ai-media-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-media-grid-wrapper-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-media-grid-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-media-grid-container-{{ ai_gen_id }}">
      <div class="ai-media-grid-item-{{ ai_gen_id }} ai-media-grid-top-{{ ai_gen_id }}">
        {% if block.settings.top_link != blank %}
          <a href="{{ block.settings.top_link }}">
        {% endif %}
          {% if block.settings.top_image %}
            <img
              src="{{ block.settings.top_image | image_url: width: 2000 }}"
              alt="{{ block.settings.top_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.top_image.width }}"
              height="{{ block.settings.top_image.height }}"
            >
          {% else %}
            <div class="ai-media-grid-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-media-grid-empty-state-{{ ai_gen_id }}">
                Add top landscape image
              </div>
            </div>
          {% endif %}
        {% if block.settings.top_link != blank %}
          </a>
        {% endif %}
      </div>

      <div class="ai-media-grid-bottom-{{ ai_gen_id }}">
        <div class="ai-media-grid-item-{{ ai_gen_id }} ai-media-grid-bottom-item-{{ ai_gen_id }} ai-media-grid-bottom-left-{{ ai_gen_id }}">
          {% if block.settings.bottom_left_link != blank %}
            <a href="{{ block.settings.bottom_left_link }}">
          {% endif %}
            {% if block.settings.bottom_left_image %}
              <img
                src="{{ block.settings.bottom_left_image | image_url: width: 1000 }}"
                alt="{{ block.settings.bottom_left_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.bottom_left_image.width }}"
                height="{{ block.settings.bottom_left_image.height }}"
              >
            {% else %}
              <div class="ai-media-grid-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-media-grid-empty-state-{{ ai_gen_id }}">
                  Add bottom left image
                </div>
              </div>
            {% endif %}
          {% if block.settings.bottom_left_link != blank %}
            </a>
          {% endif %}
        </div>

        <div class="ai-media-grid-item-{{ ai_gen_id }} ai-media-grid-bottom-item-{{ ai_gen_id }} ai-media-grid-bottom-right-{{ ai_gen_id }}">
          {% if block.settings.bottom_right_link != blank %}
            <a href="{{ block.settings.bottom_right_link }}">
          {% endif %}
            {% if block.settings.bottom_right_image %}
              <img
                src="{{ block.settings.bottom_right_image | image_url: width: 1000 }}"
                alt="{{ block.settings.bottom_right_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.bottom_right_image.width }}"
                height="{{ block.settings.bottom_right_image.height }}"
              >
            {% else %}
              <div class="ai-media-grid-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-media-grid-empty-state-{{ ai_gen_id }}">
                  Add bottom right image
                </div>
              </div>
            {% endif %}
          {% if block.settings.bottom_right_link != blank %}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</media-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class MediaGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('media-grid-{{ ai_gen_id }}', MediaGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
