        },
        {
          "value": "4/3",
          "label": "4:3 Standard"
        },
        {
          "value": "3/4",
          "label": "3:4 Portrait"
        },
        {
          "value": "16/9",
          "label": "16:9 Landscape"
        }
      ],
      "default": "1"
