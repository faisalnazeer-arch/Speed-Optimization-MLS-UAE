{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-box-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_bg_color }};
    border-radius: {{ block.settings.section_border_radius }}px;
    overflow: hidden;
    width: 100%;
    max-width: {{ block.settings.box_width_desktop }}px;
    margin: 0 auto;
  }

  .ai-image-text-box__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
  }

  .ai-image-text-box__image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 50%;
    position: relative;
    order: 2;
  }

  .ai-image-text-box__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-image-text-box__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-text-box__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-image-text-box__content-{{ ai_gen_id }} {
    flex: 0 0 50%;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    order: 1;
  }

  .ai-image-text-box__heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size_desktop }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-image-text-box__text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-image-text-box__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_size }}px;
    transition: background-color 0.3s ease;
    text-align: center;
    border: none;
    cursor: pointer;
    align-self: flex-start;
  }

  .ai-image-text-box__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-box-{{ ai_gen_id }} {
      max-width: {{ block.settings.box_width_mobile }}px;
    }

    .ai-image-text-box__container-{{ ai_gen_id }} {
      flex-direction: row;
    }

    .ai-image-text-box__image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 50%;
      order: 2;
    }

    .ai-image-text-box__content-{{ ai_gen_id }} {
      flex: 0 0 50%;
      padding: 20px;
      order: 1;
    }

    .ai-image-text-box__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px !important;
    }

    .ai-image-text-box__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.8);
    }

    .ai-image-text-box__button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_size }}px * 0.8);
      padding: 10px 16px;
    }
  }
{% endstyle %}

<div class="ai-image-text-box-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-box__container-{{ ai_gen_id }}">
    <div class="ai-image-text-box__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          class="ai-image-text-box__image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-image-text-box__image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-image-text-box__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-image-text-box__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-image-text-box__text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-image-text-box__button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image text box",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover our amazing products and special offers."
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button size",
      "default": 16
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#a70a10"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button hover background",
      "default": "#8a0808"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Box style"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Box width"
    },
    {
      "type": "range",
      "id": "box_width_desktop",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Desktop width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "box_width_mobile",
      "min": 300,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Mobile width",
      "default": 400
    }
  ],
  "presets": [
    {
      "name": "Image text box"
    }
  ]
}
{% endschema %}
