{% doc %}
  @prompt
    need circular collection slider with image upload option and width options as well
    
    with also collection names options font size options as well, title option of section as well increase collection items, item width with mobile and desktop seperately
    
    make sure scroller is working on both mobile and desktop, remove hover and increase collection  to 15 and image width option for  both and nav icons not needed just touch and scroll, slider not working
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-slider-{{ ai_gen_id }} {
    padding: 40px 0;
    overflow: hidden;
  }

  .ai-collection-slider__title-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 32px;
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
  }

  .ai-collection-slider__wrapper-{{ ai_gen_id }} {
    position: relative;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-collection-slider__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_gap }}px;
    overflow-x: scroll;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 20px 20px 20px;
    -webkit-overflow-scrolling: touch;
    user-select: none;
  }

  .ai-collection-slider__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-slider__item-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.item_width_desktop }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    user-select: none;
  }

  .ai-collection-slider__image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_width_desktop }}px;
    height: {{ block.settings.image_width_desktop }}px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 16px;
    background-color: #f4f4f4;
    flex-shrink: 0;
    pointer-events: none;
  }

  .ai-collection-slider__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .ai-collection-slider__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-collection-slider__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-slider__name-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.collection_name_color }};
    font-size: {{ block.settings.collection_name_font_size }}px;
    font-weight: 600;
    max-width: {{ block.settings.item_width_desktop }}px;
    word-wrap: break-word;
    pointer-events: none;
  }

  .ai-collection-slider__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-slider__item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.item_width_mobile }}px;
    }

    .ai-collection-slider__image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.image_width_mobile }}px;
      height: {{ block.settings.image_width_mobile }}px;
    }

    .ai-collection-slider__name-{{ ai_gen_id }} {
      max-width: {{ block.settings.item_width_mobile }}px;
    }
  }
{% endstyle %}

<collection-slider-{{ ai_gen_id }} class="ai-collection-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-collection-slider__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% endif %}

  <div class="ai-collection-slider__wrapper-{{ ai_gen_id }}">
    {% assign has_items = false %}
    {% for i in (1..15) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign image_key = 'collection_image_' | append: i
        assign name_key = 'collection_name_' | append: i
        assign collection = block.settings[collection_key]
        assign custom_image = block.settings[image_key]
        assign custom_name = block.settings[name_key]
      %}
      {% if collection != blank or custom_image != blank %}
        {% assign has_items = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_items %}
      <div class="ai-collection-slider__track-{{ ai_gen_id }}" data-slider-track>
        {% for i in (1..15) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign image_key = 'collection_image_' | append: i
            assign name_key = 'collection_name_' | append: i
            assign collection = block.settings[collection_key]
            assign custom_image = block.settings[image_key]
            assign custom_name = block.settings[name_key]
          %}

          {% if collection != blank or custom_image != blank %}
            <a
              href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}"
              class="ai-collection-slider__item-{{ ai_gen_id }}"
              data-slider-item
            >
              <div class="ai-collection-slider__image-wrapper-{{ ai_gen_id }}">
                {% if custom_image != blank %}
                  <img
                    src="{{ custom_image | image_url: width: 400 }}"
                    alt="{{ custom_name | default: collection.title | escape }}"
                    class="ai-collection-slider__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="400"
                    height="400"
                    draggable="false"
                  >
                {% elsif collection != blank and collection.image != blank %}
                  <img
                    src="{{ collection.image | image_url: width: 400 }}"
                    alt="{{ collection.title | escape }}"
                    class="ai-collection-slider__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="400"
                    height="400"
                    draggable="false"
                  >
                {% else %}
                  <div class="ai-collection-slider__image-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-collection-slider__name-{{ ai_gen_id }}">
                {% if custom_name != blank %}
                  {{ custom_name }}
                {% elsif collection != blank %}
                  {{ collection.title }}
                {% else %}
                  Collection {{ i }}
                {% endif %}
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-collection-slider__empty-state-{{ ai_gen_id }}">
        Next, add collections to display in the slider
      </div>
    {% endif %}
  </div>
</collection-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.isDragging = false;
        this.startPos = 0;
        this.currentTranslate = 0;
        this.prevTranslate = 0;
        this.animationID = 0;
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-slider-track]');
        if (!this.track) return;

        this.items = this.querySelectorAll('[data-slider-item]');
        if (this.items.length === 0) return;

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.track.addEventListener('mousedown', this.handleStart.bind(this));
        this.track.addEventListener('touchstart', this.handleStart.bind(this), { passive: true });
        
        this.track.addEventListener('mousemove', this.handleMove.bind(this));
        this.track.addEventListener('touchmove', this.handleMove.bind(this), { passive: true });
        
        this.track.addEventListener('mouseup', this.handleEnd.bind(this));
        this.track.addEventListener('mouseleave', this.handleEnd.bind(this));
        this.track.addEventListener('touchend', this.handleEnd.bind(this));
        
        this.items.forEach((item) => {
          item.addEventListener('click', (e) => {
            if (this.isDragging) {
              e.preventDefault();
            }
          });
        });
      }

      handleStart(e) {
        this.isDragging = true;
        this.startPos = this.getPositionX(e);
        this.prevTranslate = this.track.scrollLeft;
      }

      handleMove(e) {
        if (!this.isDragging) return;
        
        const currentPosition = this.getPositionX(e);
        const diff = this.startPos - currentPosition;
        this.track.scrollLeft = this.prevTranslate + diff;
      }

      handleEnd() {
        this.isDragging = false;
      }

      getPositionX(e) {
        return e.type.includes('mouse') ? e.pageX : e.touches[0].clientX;
      }
    }

    customElements.define('collection-slider-{{ ai_gen_id }}', CollectionSlider{{ ai_gen_id }});
  })();
</script>

