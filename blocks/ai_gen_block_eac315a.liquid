<div class="ai-vertical-tabs-container-{{ ai_gen_id }}">
  <vertical-tabs-{{ ai_gen_id }}
    class="ai-vertical-tabs-{{ ai_gen_id }}"
    {{ block.shopify_attributes }}>
    <div class="ai-vertical-tabs__nav-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign tab_title_key = 'tab_' | append: i | append: '_title'
          assign tab_content_key = 'tab_' | append: i | append: '_content'
          assign tab_title = block.settings[tab_title_key]
          assign tab_content = block.settings[tab_content_key]
        %}
        
        {% if tab_title != blank %}
          <button
            class="ai-vertical-tabs__tab-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-tab-id="{{ i }}"
            aria-controls="ai-vertical-tabs-panel-{{ ai_gen_id }}-{{ i }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            role="tab"
          >
            <div class="ai-vertical-tabs__bullet-{{ ai_gen_id }}"></div>
            <h3 class="ai-vertical-tabs__tab-title-{{ ai_gen_id }}">{{ tab_title }}</h3>
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-vertical-tabs__content-{{ ai_gen_id }}">
      {% assign has_content = false %}
      {% for i in (1..5) %}
        {% liquid
          assign tab_title_key = 'tab_' | append: i | append: '_title'
          assign tab_content_key = 'tab_' | append: i | append: '_content'
          assign tab_title = block.settings[tab_title_key]
          assign tab_content = block.settings[tab_content_key]
        %}
        
        {% if tab_title != blank %}
          {% assign has_content = true %}
          <div
            class="ai-vertical-tabs__panel-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            id="ai-vertical-tabs-panel-{{ ai_gen_id }}-{{ i }}"
            role="tabpanel"
            aria-labelledby="ai-vertical-tabs-tab-{{ ai_gen_id }}-{{ i }}"
          >
            <h2 class="ai-vertical-tabs__panel-title-{{ ai_gen_id }}">{{ tab_title }}</h2>
            {% if tab_content != blank %}
              <div class="ai-vertical-tabs__panel-content-{{ ai_gen_id }}">
                {{ tab_content }}
              </div>
            {% endif %}{% if block.settings.view_all_text != blank and block.settings.view_all_url != blank %}
              <a
                href="{{ block.settings.view_all_url }}"
                class="ai-vertical-tabs__view-all-{{ ai_gen_id }}"
              >
                {{ block.settings.view_all_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}

      {% unless has_content %}
        <div class="ai-vertical-tabs__empty-state-{{ ai_gen_id }}">
          Add tab titles and content to get started
        </div>
      {% endunless %}
    </div>
  </vertical-tabs-{{ ai_gen_id }}>
</div>

<script>
  (function() {
    class VerticalTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-vertical-tabs__tab-{{ ai_gen_id }}');
        this.panels = this.querySelectorAll('.ai-vertical-tabs__panel-{{ ai_gen_id }}');
        this.setupEventListeners();
        this.setupKeyboardNavigation();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const tabId = tab.getAttribute('data-tab-id');
            this.switchTab(tabId);
          });

          tab.addEventListener('keydown', (e) => {
            this.handleKeydown(e, tab);
          });
        });
      }

      setupKeyboardNavigation() {
        this.tabs.forEach((tab, index) => {
          tab.setAttribute('tabindex', index === 0 ? '0' : '-1');
        });
      }

      handleKeydown(e, currentTab) {
        const currentIndex = Array.from(this.tabs).indexOf(currentTab);
        let targetIndex;

        switch (e.key) {
          case 'Enter':
          case ' ':
            e.preventDefault();
            const tabId = currentTab.getAttribute('data-tab-id');
            this.switchTab(tabId);
            break;
          case 'ArrowDown':
            e.preventDefault();
            targetIndex = currentIndex + 1;
            if (targetIndex >= this.tabs.length) targetIndex = 0;
            this.focusTab(targetIndex);
            break;
          case 'ArrowUp':
            e.preventDefault();
            targetIndex = currentIndex - 1;
            if (targetIndex < 0) targetIndex = this.tabs.length - 1;
            this.focusTab(targetIndex);
            break;
          case 'Home':
            e.preventDefault();
            this.focusTab(0);
            break;
          case 'End':
            e.preventDefault();
            this.focusTab(this.tabs.length - 1);
            break;
        }
      }

      focusTab(index) {
        this.tabs.forEach((tab, i) => {
          tab.setAttribute('tabindex', i === index ? '0' : '-1');
        });
        this.tabs[index].focus();
      }

      switchTab(tabId) {
        this.tabs.forEach((tab) => {
          const isActive = tab.getAttribute('data-tab-id') === tabId;
          tab.classList.toggle('active', isActive);tab.setAttribute('aria-selected', isActive);
          tab.setAttribute('tabindex', isActive ? '0' : '-1');
        });

        this.panels.forEach((panel) => {
          const isActive = panel.id === `ai-vertical-tabs-panel-{{ ai_gen_id }}-${tabId}`;
          panel.classList.toggle('active', isActive);
        });
      }
    }

    customElements.define('vertical-tabs-{{ ai_gen_id }}', VerticalTabs{{ ai_gen_id }});
  })();
</script>

