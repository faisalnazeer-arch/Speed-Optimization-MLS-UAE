{% doc %}
  @prompt
    Generate a custom Shopify section using the AI section generator that creates an interactive vertical accordion or tabs component based on the analyzed image. The section should feature three vertically stacked tabs connected by a thin vertical line on the left side, resembling a timeline or step-by-step hierarchy. Each tab has a circular icon on the left (about 40-50px diameter) with a solid fill color specific to the tab, and the tab title in matching color text next to it. The background for all tabs should be white (#FFFFFF) by default, but allow for per-tab background overrides if needed. Tabs are interactive: clicking one expands it to show its full content (subtitle and any bullet points), automatically collapsing the previously open tab (accordion-style behavior). For collapsed tabs, display a small white down arrow inside the colored circle. For expanded tabs, the circle remains solid without an arrow. Bullet points should use checkmark icons in the same color as the tab's theme color.
    Specific tab details:
    
    Tab 1: Name "Economical", theme color blue (#007BFF or similar vibrant blue), circle filled blue. Subtitle: "Everyday Value for curries & rice" in black or dark gray text. Content: A bullet list with blue checkmark icons for the items "Indian Mutton", "Pakistani Beef & Mutton", "Omani Chicken", "Somali Beef & Mutton". This tab starts expanded by default.
    Tab 2: Name "Classic", theme color red (#DC3545 or similar bright red), circle filled red with down arrow when collapsed. Subtitle: "Entry level and economical grass-fed beef & lamb" in black or dark gray text. No bullet points visible in the image, so keep content empty or optional. Starts collapsed.
    Tab 3: Name "Signature", theme color dark gray or black (#343A40 or similar), circle filled dark with down arrow when collapsed. Subtitle: "Our most premium quality beef, the MLS Signature" in black or dark gray text. No bullet points visible in the image, so keep content empty or optional., Generate a cus, view all button on all tabs also needed and also this looks good on mobile but on desktop it should be horizontal tabs
    
    , all tabs closed on desktop  but on mobile first will be opened
    
    and arrow icon is not visible for first tab, not opening on mobile , center align text on desktop on mobile its good to go, no revert back to left aligned points only
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-vertical-accordion-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-vertical-accordion__tabs-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  .ai-vertical-accordion__timeline-{{ ai_gen_id }} {
    position: absolute;
    left: {{ block.settings.circle_size | divided_by: 2.0 }}px;
    top: {{ block.settings.circle_size | divided_by: 2.0 }}px;
    bottom: {{ block.settings.circle_size | divided_by: 2.0 }}px;
    width: {{ block.settings.timeline_width }}px;
    background-color: {{ block.settings.timeline_color }};
    transform: translateX(-50%);
    z-index: 0;
  }

  .ai-vertical-accordion__tab-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.tab_bg_color }};
    border-radius: {{ block.settings.tab_border_radius }}px;
    overflow: hidden;
    transition: all 0.3s ease;
    z-index: 1;
  }

  .ai-vertical-accordion__tab-{{ ai_gen_id }}:not(:last-child) {
    margin-bottom: {{ block.settings.tab_spacing }}px;
  }

  .ai-vertical-accordion__tab-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.header_gap }}px;
    padding: {{ block.settings.tab_padding }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-vertical-accordion__tab-header-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tab_hover_bg_color }};
  }

  .ai-vertical-accordion__circle-{{ ai_gen_id }} {
    width: {{ block.settings.circle_size }}px;
    height: {{ block.settings.circle_size }}px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    position: relative;
  }

  .ai-vertical-accordion__circle-icon-{{ ai_gen_id }} {
    width: 50%;
    height: 50%;
    fill: white;
    transition: transform 0.3s ease;
  }

  .ai-vertical-accordion__tab-{{ ai_gen_id }}.active .ai-vertical-accordion__circle-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-vertical-accordion__tab-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    margin: 0;
    flex-grow: 1;
  }

  .ai-vertical-accordion__tab-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.4s ease;
    padding: 0 {{ block.settings.tab_padding }}px;
  }

  .ai-vertical-accordion__tab-{{ ai_gen_id }}.active .ai-vertical-accordion__tab-content-{{ ai_gen_id }} {
    max-height: 1000px;
    padding: 0 {{ block.settings.tab_padding }}px {{ block.settings.tab_padding }}px {{ block.settings.tab_padding }}px;
  }

  .ai-vertical-accordion__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_font_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 {{ block.settings.content_spacing }}px {{ block.settings.circle_size | plus: block.settings.header_gap }}px;
  }

  .ai-vertical-accordion__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 {{ block.settings.content_spacing }}px {{ block.settings.circle_size | plus: block.settings.header_gap }}px;
  }

  .ai-vertical-accordion__list-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: {{ block.settings.list_item_spacing }}px;
    font-size: {{ block.settings.list_font_size }}px;
    color: {{ block.settings.list_text_color }};
  }

  .ai-vertical-accordion__list-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-vertical-accordion__checkmark-{{ ai_gen_id }} {
    width: {{ block.settings.checkmark_size }}px;
    height: {{ block.settings.checkmark_size }}px;
    flex-shrink: 0;
  }

  .ai-vertical-accordion__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: transparent;
    border: {{ block.settings.button_border_width }}px solid;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    margin-left: {{ block.settings.circle_size | plus: block.settings.header_gap }}px;
  }

  .ai-vertical-accordion__button-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  @media screen and (min-width: 750px) {
    .ai-vertical-accordion__tabs-{{ ai_gen_id }} {
      flex-direction: row;
      gap: {{ block.settings.tab_spacing }}px;
    }

    .ai-vertical-accordion__timeline-{{ ai_gen_id }} {
      left: {{ block.settings.circle_size | divided_by: 2.0 }}px;
      right: {{ block.settings.circle_size | divided_by: 2.0 }}px;
      top: {{ block.settings.circle_size | divided_by: 2.0 }}px;
      bottom: auto;
      width: auto;
      height: {{ block.settings.timeline_width }}px;
      transform: translateY(-50%);
    }

    .ai-vertical-accordion__tab-{{ ai_gen_id }} {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .ai-vertical-accordion__tab-{{ ai_gen_id }}:not(:last-child) {
      margin-bottom: 0;
    }

    .ai-vertical-accordion__tab-header-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
      gap: {{ block.settings.header_gap | times: 0.75 }}px;
    }

    .ai-vertical-accordion__tab-title-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-vertical-accordion__tab-content-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.tab_padding }}px;
    }

    .ai-vertical-accordion__tab-{{ ai_gen_id }}.active .ai-vertical-accordion__tab-content-{{ ai_gen_id }} {
      padding: {{ block.settings.tab_padding }}px;
    }

    .ai-vertical-accordion__subtitle-{{ ai_gen_id }} {
      margin-left: 0;
      text-align: center;
    }

    .ai-vertical-accordion__list-{{ ai_gen_id }} {
      margin-left: 0;
    }

    .ai-vertical-accordion__button-{{ ai_gen_id }} {
      margin-left: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-vertical-accordion-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 16px;
    }

    .ai-vertical-accordion__tab-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }

    .ai-vertical-accordion__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_font_size | times: 0.9 }}px;
    }

    .ai-vertical-accordion__list-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.list_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<vertical-accordion-{{ ai_gen_id }} class="ai-vertical-accordion-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
