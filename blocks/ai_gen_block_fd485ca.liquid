<script>
  (function() {
    class VerticalAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-vertical-accordion__tab-{{ ai_gen_id }}');
        this.initializeMobileFirst();
        this.setupEventListeners();
        this.handleResize();
      }

      initializeMobileFirst() {
        if (window.innerWidth < 750) {
          const firstTab = this.querySelector('.mobile-first-active');
          if (firstTab) {
            firstTab.classList.add('active');
          }
        }
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          const header = tab.querySelector('.ai-vertical-accordion__tab-header-{{ ai_gen_id }}');
          
          header.addEventListener('click', () => {
            const isActive = tab.classList.contains('active');
            
            this.tabs.forEach((t) => {
              t.classList.remove('active');
            });
            
            if (!isActive) {
              tab.classList.add('active');
            }
          });
        });
      }

      handleResize() {
        let previousWidth = window.innerWidth;
        
        window.addEventListener('resize', () => {
          const currentWidth = window.innerWidth;
          const wasMobile = previousWidth < 750;
          const isMobile = currentWidth < 750;
          
          if (wasMobile !== isMobile) {
            this.tabs.forEach((tab) => {
              tab.classList.remove('active');
            });
            
            if (isMobile) {
              const firstTab = this.querySelector('.mobile-first-active');
              if (firstTab) {
                firstTab.classList.add('active');
              }
            }
          }
          
          previousWidth = currentWidth;
        });
      }
    }

    customElements.define('vertical-accordion-{{ ai_gen_id }}', VerticalAccordion{{ ai_gen_id }});
  })();
</script>

