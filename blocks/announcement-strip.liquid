{% doc %}
  @prompt
    need a strip where i can 4 short lines with icons to left but i can decide only visible on collections, homepage or all website
    
    make sure optimized and responsive on mobile, 2 in a row on mobile and i can hide the icons as well
    
    icons i can upload as well, center them if i use 2 items it should be centered 
    
    , no of items to show on mobile and desktop also needed
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign show_on_homepage = block.settings.show_on_homepage
  assign show_on_collections = block.settings.show_on_collections
  assign show_on_all = block.settings.show_on_all

  assign should_display = false

  if show_on_all
    assign should_display = true
  elsif show_on_homepage and template.name == 'index'
    assign should_display = true
  elsif show_on_collections and template.name == 'collection'
    assign should_display = true
  endif

  assign active_items = 0
  for i in (1..4)
    assign text_key = 'text_' | append: i
    assign text_value = block.settings[text_key]
    if text_value != blank
      assign active_items = active_items | plus: 1
    endif
  endfor
%}

{% if should_display %}
  {% style %}
    .ai-icon-strip-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      background-color: {{ block.settings.background_color }};
      padding: {{ block.settings.padding_vertical }}px 20px;
    }

    .ai-icon-strip-container-{{ ai_gen_id }} {
      max-width: {{ block.settings.max_width }}px;
      margin: 0 auto;
      width: {{ block.settings.desktop_width_percent }}%;
    }

    .ai-icon-strip-grid-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: repeat({{ block.settings.items_per_row_desktop }}, 1fr);
      gap: {{ block.settings.gap }}px;
      align-items: center;
      justify-items: {{ block.settings.alignment }};
    }

    .ai-icon-strip-item-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      gap: {{ block.settings.icon_text_gap }}px;
    }

    .ai-icon-strip-icon-{{ ai_gen_id }} {
      flex-shrink: 0;
      width: {{ block.settings.icon_size }}px;
      height: {{ block.settings.icon_size }}px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    {% if block.settings.hide_icons %}
      .ai-icon-strip-icon-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}

    .ai-icon-strip-icon-{{ ai_gen_id }} svg {
      width: 100%;
      height: 100%;
      fill: {{ block.settings.icon_color }};
    }

    .ai-icon-strip-icon-{{ ai_gen_id }} img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .ai-icon-strip-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size }}px;
      color: {{ block.settings.text_color }};
      line-height: 1.3;
      font-weight: {{ block.settings.text_weight }};
    }

    @media screen and (max-width: 989px) {
      .ai-icon-strip-grid-{{ ai_gen_id }} {
        grid-template-columns: repeat({{ block.settings.items_per_row_mobile }}, 1fr);
        gap: {{ block.settings.gap_mobile }}px;
        justify-items: {{ block.settings.alignment_mobile }};
      }

      .ai-icon-strip-icon-{{ ai_gen_id }} {
        width: {{ block.settings.icon_size_mobile }}px;
        height: {{ block.settings.icon_size_mobile }}px;
      }

      .ai-icon-strip-text-{{ ai_gen_id }} {
        font-size: {{ block.settings.text_size_mobile }}px;
      }

      .ai-icon-strip-{{ ai_gen_id }} {
        padding: {{ block.settings.padding_vertical_mobile }}px 16px;
      }
    }
  {% endstyle %}

  <div class="ai-icon-strip-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-icon-strip-container-{{ ai_gen_id }}">
      <div class="ai-icon-strip-grid-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign text_key = 'text_' | append: i
            assign icon_key = 'icon_' | append: i
            assign custom_icon_key = 'custom_icon_' | append: i
            assign text_value = block.settings[text_key]
            assign icon_value = block.settings[icon_key]
            assign custom_icon_value = block.settings[custom_icon_key]
          %}

          {% if text_value != blank %}
            <div class="ai-icon-strip-item-{{ ai_gen_id }}">
              <div class="ai-icon-strip-icon-{{ ai_gen_id }}">
                {% if custom_icon_value != blank %}
                  <img
                    src="{{ custom_icon_value | image_url: width: 100 }}"
                    alt="{{ text_value }}"
                    loading="lazy"
                    width="100"
                    height="100"
                  >
                {% else %}
                  {% case icon_value %}
                    {% when 'truck' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13"></rect>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                      </svg>
                    {% when 'shield' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                      </svg>
                    {% when 'check' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    {% when 'star' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                      </svg>
                    {% when 'gift' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 12 20 22 4 22 4 12"></polyline>
                        <rect x="2" y="7" width="20" height="5"></rect>
                        <line x1="12" y1="22" x2="12" y2="7"></line>
                        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                      </svg>
                    {% when 'clock' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                    {% when 'heart' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                      </svg>
                    {% when 'phone' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                      </svg>
                    {% when 'award' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="7"></circle>
                        <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                      </svg>
                    {% when 'lock' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                      </svg>
                    {% when 'refresh' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="23 4 23 10 17 10"></polyline>
                        <polyline points="1 20 1 14 7 14"></polyline>
                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                      </svg>
                    {% when 'package' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                      </svg>
                  {% endcase %}
                {% endif %}
              </div>
              <div class="ai-icon-strip-text-{{ ai_gen_id }}">{{ text_value }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

