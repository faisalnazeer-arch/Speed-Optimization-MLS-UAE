{% doc %}
  @prompt
    Build a modern, high-conversion 'Shop by Price' section for Shopify. Create a grid of responsive cards where I can link specific collections. Each card must feature a high-quality collection image as the background with a slight dark overlay. On top of the image, center a large, bold white text label (e.g., 'Under $20')."
    Layout Requirements:
    Desktop: Display a grid of 4 cards per row.
    Mobile: Display a grid of 2 cards per row for better readability.
    Customization: Ensure the number of cards per row is adjustable (options for 2, 3, or 4).
    Interactivity: Add a subtle 'zoom-in' hover effect on the background image and a 'pointer' cursor.
    Styling:
    Borders: Use a clean 12px border-radius for a modern look.
    Spacing: Add 20px gap between cards and 60px padding for the top and bottom of the section.
    Typography: Use a clean Sans-Serif font (like Montserrat or Inter), bold weight, size 24px., names should be below the card and where is image upload option also mention recomended sizes of image for landscape portrait and square, adapt to image option as well
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-by-price-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.section_bg_color }};
  }

  .ai-shop-by-price-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-shop-by-price-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 40px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-shop-by-price-grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.card_gap }}px;
    grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
  }

  @media screen and (min-width: 750px) {
    .ai-shop-by-price-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    }
  }

  .ai-shop-by-price-card-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-shop-by-price-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    cursor: pointer;
    display: block;
    text-decoration: none;
  }

  .ai-shop-by-price-card-{{ ai_gen_id }}--square {
    aspect-ratio: 1;
  }

  .ai-shop-by-price-card-{{ ai_gen_id }}--landscape {
    aspect-ratio: 1.33;
  }

  .ai-shop-by-price-card-{{ ai_gen_id }}--portrait {
    aspect-ratio: 0.75;
  }

  .ai-shop-by-price-card-{{ ai_gen_id }}--adapt {
    aspect-ratio: auto;
  }

  .ai-shop-by-price-image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transition: transform 0.4s ease;
  }

  .ai-shop-by-price-card-{{ ai_gen_id }}--adapt .ai-shop-by-price-image-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-shop-by-price-card-{{ ai_gen_id }}:hover .ai-shop-by-price-image-wrapper-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-shop-by-price-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-shop-by-price-card-{{ ai_gen_id }}--adapt .ai-shop-by-price-image-{{ ai_gen_id }} {
    object-fit: contain;
    display: block;
  }

  .ai-shop-by-price-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-shop-by-price-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-shop-by-price-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    z-index: 1;
  }

  .ai-shop-by-price-label-{{ ai_gen_id }} {
    color: {{ block.settings.label_color }};
    font-size: {{ block.settings.label_size }}px;
    font-weight: 700;
    text-align: {{ block.settings.label_alignment }};
    padding: 0 12px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    line-height: 1.3;
  }

  .ai-shop-by-price-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    font-size: 12px;
    border-radius: 4px;
    white-space: nowrap;
    z-index: 2;
  }
{% endstyle %}

<shop-by-price-{{ ai_gen_id }} class="ai-shop-by-price-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shop-by-price-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-shop-by-price-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-shop-by-price-grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign label_key = 'label_' | append: i
          assign link_key = 'link_' | append: i
          assign image = block.settings[image_key]
          assign label = block.settings[label_key]
          assign link = block.settings[link_key]

          if block.settings.card_aspect_ratio == '1'
            assign aspect_class = 'ai-shop-by-price-card-' | append: ai_gen_id | append: '--square'
          elsif block.settings.card_aspect_ratio == '1.33'
            assign aspect_class = 'ai-shop-by-price-card-' | append: ai_gen_id | append: '--landscape'
          elsif block.settings.card_aspect_ratio == '0.75'
            assign aspect_class = 'ai-shop-by-price-card-' | append: ai_gen_id | append: '--portrait'
          else
            assign aspect_class = 'ai-shop-by-price-card-' | append: ai_gen_id | append: '--adapt'
          endif
        %}

        {% if image != blank or label != blank %}
          <div class="ai-shop-by-price-card-wrapper-{{ ai_gen_id }}">
            <a
              href="{% if link != blank %}{{ link }}{% else %}#{% endif %}"
              class="ai-shop-by-price-card-{{ ai_gen_id }} {{ aspect_class }}"
              {% if link == blank %}onclick="return false;"{% endif %}
              {% if label != blank %}aria-label="{{ label }}"{% endif %}
            >
              <div class="ai-shop-by-price-image-wrapper-{{ ai_gen_id }}">
                {% if image %}
                  <img
                    src="{{ image | image_url: width: 800 }}"
                    alt="{{ image.alt | escape }}"
                    loading="lazy"
                    width="800"
                    height="800"
                    class="ai-shop-by-price-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-shop-by-price-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-shop-by-price-overlay-{{ ai_gen_id }}"></div>

              {% if image == blank and label != blank %}
                <div class="ai-shop-by-price-empty-state-{{ ai_gen_id }}">
                  Next, add an image
                </div>
              {% endif %}
            </a>

            {% if label != blank %}
              <div class="ai-shop-by-price-label-{{ ai_gen_id }}">{{ label }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</shop-by-price-{{ ai_gen_id }}>

<script>
  (function() {
    class ShopByPrice{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-shop-by-price-card-{{ ai_gen_id }}');
      }
    }

    customElements.define('shop-by-price-{{ ai_gen_id }}', ShopByPrice{{ ai_gen_id }});
  })();
</script>

