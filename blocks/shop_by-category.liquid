{% doc %}
  @prompt
    Create a "Shop by Category" section for my online meat store.
    
    Section title: "Shop by Category" (centered, bold, large text)
    Show 20 category cards in a responsive grid layout.
    Desktop: 5 cards per row
    Mobile: 3 cards per row
    Each card should be a square with:
    Rounded corners (border radius 12px)
    Light background color (soft pink or light beige)
    A centered image/icon at the top (allow me to upload a custom image for each category)
    Category name in bold text below the image
    Make each card clickable (allow me to add a link for each category)
    
    Add a toggle or buttons at the top to switch between Grid view (default) and Carousel view (horizontal scroll)
    Categories to include:
    
    
    Beef
    Lamb
    Chicken
    Veal
    Ostrich
    Turkey
    Venison
    Seasoned
    Whole Cuts
    Whole Carcass
    
    
    Keep the design clean, modern, and simple with plenty of space between cards. Use red or dark red text for category names to match a meat theme.
    , view should be on backend not for customers to select
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-category-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-shop-category-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-shop-category-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 32px;
  }

  .ai-shop-category-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0;
  }

  .ai-shop-category-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-shop-category-carousel-{{ ai_gen_id }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-shop-category-carousel-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-shop-category-carousel-{{ ai_gen_id }} .ai-shop-category-card-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: 200px;
    scroll-snap-align: start;
  }

  .ai-shop-category-card-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1;
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    text-decoration: none;
  }

  .ai-shop-category-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-shop-category-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 60%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .ai-shop-category-image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .ai-shop-category-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: 8px;
  }

  .ai-shop-category-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-shop-category-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_name_size }}px;
    font-weight: 700;
    color: {{ block.settings.category_name_color }};
    text-align: center;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-shop-category-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }

    .ai-shop-category-carousel-{{ ai_gen_id }} .ai-shop-category-card-{{ ai_gen_id }} {
      width: 150px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-shop-category-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-shop-category-card-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-shop-category-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.category_name_size | times: 0.9 }}px;
    }
  }

  {% if block.settings.layout_style == 'carousel' %}
    .ai-shop-category-grid-{{ ai_gen_id }} {
      display: none;
    }
  {% else %}
    .ai-shop-category-carousel-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}
{% endstyle %}

<div
  class="ai-shop-category-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-shop-category-container-{{ ai_gen_id }}">
    <div class="ai-shop-category-header-{{ ai_gen_id }}">
      {% if block.settings.section_title != blank %}
        <h2 class="ai-shop-category-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      {% endif %}
    </div>

    <div class="ai-shop-category-grid-{{ ai_gen_id }}">
      {% for i in (1..20) %}
        {% liquid
          assign category_name_key = 'category_' | append: i | append: '_name'
          assign category_image_key = 'category_' | append: i | append: '_image'
          assign category_link_key = 'category_' | append: i | append: '_link'

          assign category_name = block.settings[category_name_key]
          assign category_image = block.settings[category_image_key]
          assign category_link = block.settings[category_link_key]
        %}

        {% if category_name != blank %}
          <a
            href="{{ category_link }}"
            class="ai-shop-category-card-{{ ai_gen_id }}"
          >
            <div class="ai-shop-category-image-wrapper-{{ ai_gen_id }}">
              {% if category_image %}
                <img
                  src="{{ category_image | image_url: width: 300 }}"
                  alt="{{ category_name | escape }}"
                  class="ai-shop-category-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="300"
                  height="300"
                >
              {% else %}
                <div class="ai-shop-category-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <h3 class="ai-shop-category-name-{{ ai_gen_id }}">{{ category_name }}</h3>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-shop-category-carousel-{{ ai_gen_id }}">
      {% for i in (1..20) %}
        {% liquid
          assign category_name_key = 'category_' | append: i | append: '_name'
          assign category_image_key = 'category_' | append: i | append: '_image'
          assign category_link_key = 'category_' | append: i | append: '_link'

          assign category_name = block.settings[category_name_key]
          assign category_image = block.settings[category_image_key]
          assign category_link = block.settings[category_link_key]
        %}

        {% if category_name != blank %}
          <a
            href="{{ category_link }}"
            class="ai-shop-category-card-{{ ai_gen_id }}"
          >
            <div class="ai-shop-category-image-wrapper-{{ ai_gen_id }}">
              {% if category_image %}
                <img
                  src="{{ category_image | image_url: width: 300 }}"
                  alt="{{ category_name | escape }}"
                  class="ai-shop-category-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="300"
                  height="300"
                >
              {% else %}
                <div class="ai-shop-category-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <h3 class="ai-shop-category-name-{{ ai_gen_id }}">{{ category_name }}</h3>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

