

<div class="shop-by-origin">
  <div class="tab-container">
    <button class="tab active" data-tab="lamb">Lamb</button>
    <button class="tab" data-tab="beef">Beef</button>
  </div>

  <div class="blocks-container">
    {% for block in section.blocks %}
      <div class="block {{ block.type }} {% if block.index == 0 %}active{% endif %}" data-tab="{{ block.type }}">
        <img src="{{ block.settings.image | img_url: '300x300' }}" alt="{{ block.settings.text }}">
        <p>{{ block.settings.text }}</p>
        <a href="{{ block.settings.link }}" class="btn">Shop Now</a>
      </div>
    {% endfor %}
  </div>
</div>




{% schema %}
{
  "name": "Shop by Origin",
  "settings": [],
  "blocks": [
    {
      "type": "lamb",
      "name": "Lamb",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "beef",
      "name": "Beef",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Origin",
      "category": "Custom"
    }
  ]
}
{% endschema %}


<style>
  .shop-by-origin {
  text-align: center;
}

.tab-container {
  display: flex;
  justify-content: center;
  margin-bottom: 20px;
}

.tab {
  background-color: #f7f7f7;
  border: 1px solid #ddd;
  padding: 10px 20px;
  cursor: pointer;
}

.tab.active {
  background-color: #d8232a;
  color: #fff;
}

.blocks-container {
  display: flex;
  justify-content: space-around;
}

.block {
  display: none;
  text-align: center;
}

.block.active {
  display: block;
}

.block img {
  max-width: 100px;
  margin-bottom: 10px;
}

.block p {
  font-weight: bold;
  margin-bottom: 10px;
}

.block a.btn {
  background-color: #d8232a;
  color: #fff;
  padding: 10px 20px;
  text-decoration: none;
}

</style>


<script>
  document.addEventListener('DOMContentLoaded', function() {
  const tabs = document.querySelectorAll('.tab');
  const blocks = document.querySelectorAll('.block');

  tabs.forEach(tab => {
    tab.addEventListener('click', function() {
      // Remove active class from all tabs and blocks
      tabs.forEach(tab => tab.classList.remove('active'));
      blocks.forEach(block => block.classList.remove('active'));

      // Add active class to clicked tab and corresponding block
      tab.classList.add('active');
      const tabType = tab.getAttribute('data-tab');
      document.querySelector(`.block.${tabType}`).classList.add('active');
    });
  });
});

</script>