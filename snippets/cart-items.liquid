{%- comment -%}
  Parameters:
  - is_drawer {Boolean} - Is cart drawer.

  Usage:
  {% render 'cart-items', is_drawer: true %}
{%- endcomment -%}

{%- if cart != empty -%}
  <script type="lazyload_int" data-src="{{ 'cart-items.js' | asset_url }}"></script>
{%- endif -%}

{%- liquid
  if is_drawer
    assign section_id = 'cart-drawer'
  else
    assign section_id = section.id
  endif
-%}

<cart-items
  id="cart-items"
  data-section="{{ section_id }}"
  data-empty="{% if cart == empty %}true{% else %}false{% endif %}"
>
  {%- if cart == empty -%}
    {%- liquid
      assign _ec_coll_1 = section.settings.empty_cart_coll_1
      assign _ec_coll_2 = section.settings.empty_cart_coll_2
      assign _ec_coll_3 = section.settings.empty_cart_coll_3
      assign _ec_prod_coll = section.settings.empty_cart_products_coll
    -%}

    <div class="cart-empty js-cart-empty mls-ec">

      <div class="mls-ec__hero">
        <div class="mls-ec__hero-icon">🛒</div>
        <h2 class="mls-ec__hero-title">{{ 'cart.general.empty' | t }}</h2>
        <p class="mls-ec__hero-sub">Discover something you'll love</p>
      </div>

      {%- if _ec_coll_1 != blank or _ec_coll_2 != blank or _ec_coll_3 != blank -%}
        <div class="mls-ec__section">
          <div class="mls-ec__section-header">
            <span class="mls-ec__section-title">Shop by Category</span>
          </div>
          <div class="mls-ec__cat-grid">
            {%- if _ec_coll_1 != blank -%}
              <a href="{{ _ec_coll_1.url }}" class="mls-ec__cat-card js-close-drawer">
                <div class="mls-ec__cat-img-wrap">
                  {%- if _ec_coll_1.image -%}
                    <img src="{{ _ec_coll_1.image | image_url: width: 220 }}" alt="{{ _ec_coll_1.title | escape }}" loading="lazy" width="220" height="220">
                  {%- else -%}
                    <span class="mls-ec__cat-fallback">🛍️</span>
                  {%- endif -%}
                </div>
                <span class="mls-ec__cat-name">{{ _ec_coll_1.title }}</span>
              </a>
            {%- endif -%}
            {%- if _ec_coll_2 != blank -%}
              <a href="{{ _ec_coll_2.url }}" class="mls-ec__cat-card js-close-drawer">
                <div class="mls-ec__cat-img-wrap">
                  {%- if _ec_coll_2.image -%}
                    <img src="{{ _ec_coll_2.image | image_url: width: 220 }}" alt="{{ _ec_coll_2.title | escape }}" loading="lazy" width="220" height="220">
                  {%- else -%}
                    <span class="mls-ec__cat-fallback">🛍️</span>
                  {%- endif -%}
                </div>
                <span class="mls-ec__cat-name">{{ _ec_coll_2.title }}</span>
              </a>
            {%- endif -%}
            {%- if _ec_coll_3 != blank -%}
              <a href="{{ _ec_coll_3.url }}" class="mls-ec__cat-card js-close-drawer">
                <div class="mls-ec__cat-img-wrap">
                  {%- if _ec_coll_3.image -%}
                    <img src="{{ _ec_coll_3.image | image_url: width: 220 }}" alt="{{ _ec_coll_3.title | escape }}" loading="lazy" width="220" height="220">
                  {%- else -%}
                    <span class="mls-ec__cat-fallback">🛍️</span>
                  {%- endif -%}
                </div>
                <span class="mls-ec__cat-name">{{ _ec_coll_3.title }}</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if _ec_prod_coll != blank and _ec_prod_coll.products_count > 0 -%}
        <div class="mls-ec__section">
          <div class="mls-ec__section-header">
            <span class="mls-ec__section-title">{{ _ec_prod_coll.title }}</span>
          </div>
          <div class="mls-ec__slider-outer">
            <button type="button" class="mls-ec__nav-btn mls-ec__prev" aria-label="Previous" disabled>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <div class="mls-ec__slider-wrap">
              <div class="mls-ec__slider-track">
                {%- for _ec_p in _ec_prod_coll.products limit: 9 -%}
                  <div class="mls-ec__prod-card">
                    <a href="{{ _ec_p.url }}" class="mls-ec__prod-link js-close-drawer">
                      <div class="mls-ec__prod-img-wrap">
                        {%- if _ec_p.featured_image -%}
                          <img src="{{ _ec_p.featured_image | image_url: width: 160 }}" alt="{{ _ec_p.title | escape }}" loading="lazy" width="160" height="160">
                        {%- else -%}
                          <span class="mls-ec__prod-fallback">🛍️</span>
                        {%- endif -%}
                      </div>
                      <div class="mls-ec__prod-body">
                        <p class="mls-ec__prod-name">{{ _ec_p.title }}</p>
                        <p class="mls-ec__prod-price">{{ _ec_p.price_min | money }}</p>
                      </div>
                    </a>
                    {%- if _ec_p.available -%}
                      <button class="mls-ec__atc" data-mls-atc data-variant-id="{{ _ec_p.first_available_variant.id }}">+ Add</button>
                    {%- else -%}
                      <button class="mls-ec__atc" disabled>Sold Out</button>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>
            <button type="button" class="mls-ec__nav-btn mls-ec__next" aria-label="Next">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
          <div class="mls-ec__dots">
            {%- assign _ec_total = _ec_prod_coll.products_count | at_most: 9 -%}
            {%- assign _ec_dot_count = _ec_total | plus: 2 | divided_by: 3 -%}
            {%- for i in (1.._ec_dot_count) -%}
              <span class="mls-ec__dot{% if forloop.first %} is-active{% endif %}"></span>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="mls-ec__cta-wrap">
        <a href="/collections/all" class="mls-ec__cta js-close-drawer">Browse All Products</a>
      </div>

    </div>

    <script>
    (function(){
      function initMlsSlider() {
        var wrap = document.querySelector('.mls-ec__slider-wrap');
        if (!wrap || wrap.dataset.mlsInit) return;
        wrap.dataset.mlsInit = '1';
        var track = wrap.querySelector('.mls-ec__slider-track');
        var cards = track.querySelectorAll('.mls-ec__prod-card');
        var outer = wrap.closest('.mls-ec__slider-outer');
        var prev  = outer ? outer.querySelector('.mls-ec__prev') : null;
        var next  = outer ? outer.querySelector('.mls-ec__next') : null;
        var section = wrap.closest('.mls-ec__section');
        var dotsEl = section ? section.querySelectorAll('.mls-ec__dot') : [];
        var cur = 0;
        var total = Math.ceil(cards.length / 3);
        function step() { return wrap.offsetWidth; }
        function goTo(p) {
          cur = Math.max(0, Math.min(p, total - 1));
          track.style.transform = 'translateX(-' + (cur * step()) + 'px)';
          dotsEl.forEach(function(d,i){ d.classList.toggle('is-active', i === cur); });
          if (prev) prev.disabled = cur === 0;
          if (next) next.disabled = cur >= total - 1;
        }
        if (prev) prev.addEventListener('click', function(){ goTo(cur - 1); });
        if (next) next.addEventListener('click', function(){ goTo(cur + 1); });
        dotsEl.forEach(function(d,i){ d.addEventListener('click', function(){ goTo(i); }); });
        window.addEventListener('resize', function(){ goTo(cur); });
        goTo(0);
      }
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-mls-atc]');
        if (!btn || btn.disabled) return;
        var variantId = btn.dataset.variantId;
        if (!variantId) return;
        var orig = btn.textContent;
        btn.disabled = true;
        btn.textContent = '...';
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: Number(variantId), quantity: 1 })
        })
        .then(function(r){ if (!r.ok) throw new Error(); return r.json(); })
        .then(function(item){
          btn.textContent = '✓';
          document.dispatchEvent(new CustomEvent('cart:item-added', { bubbles: true, detail: { item: item } }));
          var cartDrawerEl = document.getElementById('cart-drawer');
          if (cartDrawerEl && typeof cartDrawerEl.refreshCartDrawer === 'function') {
            cartDrawerEl.refreshCartDrawer();
          }
        })
        .catch(function(){ btn.disabled = false; btn.textContent = orig; });
      });
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMlsSlider);
      } else {
        requestAnimationFrame(initMlsSlider);
      }
    })();
    </script>
  {%- endif -%}

  {%- if cart != empty -%}
    <table class="cart-items w-full">
      <thead class="visually-hidden">
        <tr>
          <th colspan="2">{{ 'cart.items.product' | t }}</th>
          <th>{{ 'cart.items.price' | t }}</th>
          <th>{{ 'cart.items.quantity' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for item in cart.items -%}
          {%- liquid
            if item.variant.compare_at_price > item.variant.price
              assign variant_price_reduced = true
            else
              assign variant_price_reduced = false
            endif
          -%}
          <tr
            class="cart-item grid {% if is_drawer %}gap-x-5{% else %}gap-x-8{% endif %}"
            id="cart-item-{{ item.index | plus: 1 }}"
            data-product-id="{{ item.product_id }}"
            data-variant-id="{{ item.variant_id }}"
          >
            <td class="cart-item__image">
              <a href="{{ item.url }}" class="block {% if settings.blend_product_images %} image-blend{% endif %}">
                {%- if item.image -%}
                  {%- capture sizes -%}
                    {%- render 'sizes-attribute', min: '64px', sm: '128px', md: false, lg: false, xl: false, max: false -%}
                  {%- endcapture -%}
                  {{
                    item.image
                    | image_url: width: 180
                    | image_tag: widths: '64, 128, 180', sizes: sizes, loading: 'lazy'
                  }}
                {%- else -%}
                  <div class="media relative" style="padding-top: 100%;">
                    {{ 'image' | placeholder_svg_tag: 'media__placeholder img-fit' }}
                  </div>
                {%- endif -%}
              </a>
            </td>
            <td class="cart-item__details">
              {%- if section.settings.show_vendor and item.vendor != blank -%}
                <div class="text-theme-light text-sm mb-1">
                  {{ item.vendor }}
                </div>
              {%- endif -%}

              <a class="cart-item__title m-0 font-bold text-current js-item-name" href="{{ item.url }}">
                {{- item.product.title | escape -}}

                {%- if settings.cart_show_weight and item.variant.weight > 0 -%}
                  <span class="cart-item__weight text-sm font-normal whitespace-nowrap">
                    {{ item.variant.weight | weight_with_unit: item.variant.weight_unit }}
                  </span>
                {%- endif -%}
              </a>

              <div class="cart-item__info{% if settings.sale_price_color_card %} price--sale-color{% endif %}">
                {%- if variant_price_reduced or item.original_line_price != item.final_line_price -%}
                  <!--
                    <dl class="m-0">
                      <dt class="visually-hidden">
                        {{- 'products.product.price.sale_price' | t -}}
                      </dt>
                      <dd class="price__current inline m-0 font-bold">
                        {%- render 'price-as-money', price: item.final_price, show_money_with_currency: false -%}
                      </dd>
                      <dt class="visually-hidden">
                        {{- 'products.product.price.regular_price' | t -}}
                      </dt>
                      <dd class="inline m-0">
                        {%- if variant_price_reduced -%}
                          <s class="price__was{% if settings.superscript_decimals %} price__was--supercents{% endif %}">{%- render 'price-as-money', price: item.variant.compare_at_price, show_money_with_currency: false -%}</s>
                        {%- else -%}
                          <s class="price__was{% if settings.superscript_decimals %} price__was--supercents{% endif %}">{%- render 'price-as-money', price: item.original_price, show_money_with_currency: false -%}</s>
                        {%- endif -%}
                      </dd>
                    </dl>
                  -->
                {%- else -%}
                  <strong class="price__current">
                    {%- render 'price-as-money', price: item.original_price, show_money_with_currency: false -%}
                  </strong>
                {%- endif -%}

                {%- if item.unit_price_measurement -%}
                  <div class="unit-price text-theme-light">
                    <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                    <span class="unit-price__price">
                      {%- render 'price-as-money', price: item.unit_price, show_money_with_currency: false -%}
                    </span>
                    <span class="unit-price__separator">{{ 'products.product.price.unit_price_separator' | t }}</span>
                    <span class="unit-price__unit">
                      {%- if item.unit_price_measurement.reference_value != 1 -%}
                        {{- item.unit_price_measurement.reference_value -}}
                      {%- endif -%}
                      {{ item.unit_price_measurement.reference_unit }}
                    </span>
                  </div>
                {%- endif -%}

                {%- if item.product.template_suffix contains 'preorder' -%}
                  <div class="mt-2">
                    <span class="product-label product-label--preorder">
                      {% if settings.preorder_label_icon != 'none' %}
                        {% render 'icon', icon: settings.preorder_label_icon, width: 14, height: 14 %}
                      {% endif %}
                      {{- 'products.product.preorder' | t -}}
                    </span>
                  </div>
                {%- endif -%}

                {%- if item.product.has_only_default_variant == false
                  or item.properties.size != null
                  or item.selling_plan_allocation != null
                -%}
                  <div class="cart-item__variants text-sm">
                    <dl class="mt-2 mb-0">
                      {%- if item.product.has_only_default_variant == false -%}
                        {%- for option in item.options_with_values -%}
                          <div>
                            <dt class="inline">
                              <strong>{{ option.name }}: </strong>
                            </dt>
                            <dd class="inline m-0">{{ option.value }}</dd>
                          </div>
                        {%- endfor -%}
                      {%- endif -%}

                      {%- for property in item.properties -%}
                        {%- assign property_first_char = property.first | slice: 0 -%}
                        {%- if property.last != blank and property_first_char != '_' -%}
                          <div>
                            <dt class="inline">
                              <strong>{{ property.first }}: </strong>
                            </dt>
                            <dd class="inline m-0">
                              {%- if property.last contains '/uploads/' -%}
                                <a href="{{ property.last }}" class="link" target="_blank">
                                  {{ property.last | split: '/' | last }}
                                </a>
                              {%- else -%}
                                {{ property.last }}
                              {%- endif -%}
                            </dd>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </dl>

                    {%- if item.selling_plan_allocation != null -%}
                      <p class="mt-1 mb-0">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                    {%- endif -%}
                  </div>
                {% else %}
                  <!-- PO - Easify fix -->
                  <div class="cart-item__variants text-sm">
                    <dl class="mt-2 mb-0">
                      {%- for property in item.properties -%}
                        {%- assign property_first_char = property.first | slice: 0 -%}
                        {%- if property.last != blank and property_first_char != '_' -%}
                          <div>
                            <dt class="inline">
                              <strong>{{ property.first }}: </strong>
                            </dt>
                            <dd class="inline m-0">
                              {%- if property.last contains '/uploads/' -%}
                                <a href="{{ property.last }}" class="link" target="_blank">
                                  {{ property.last | split: '/' | last }}
                                </a>
                              {%- else -%}
                                {{ property.last }}
                              {%- endif -%}
                            </dd>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </dl>
                  </div>
                  <!-- End - PO - Easify fix -->
                {%- endif -%}

                {%- if section.settings.show_backorder_text -%}
                  {% render 'backorder', product: item.product, variant: item.variant %}
                {%- endif -%}

                {%- if item.discounts.size > 0 -%}
                  <ul class="mt-3 mb-2 font-bold" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                    {%- for discount in item.discounts -%}
                      <li class="mt-2">
                        <div class="discount text-sm inline-flex items-center text-start" dir="auto">
                          {% render 'icon-tags' %}
                          {{- discount.title | escape_once -}}
                        </div>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </td>

            <td class="cart-item__qty">
              <div class="flex items-center mt-3">
                {% render 'quantity-input', is_cart: true, item: item, layout_style: 'combined' %}
                <a
                  class="cart-item__remove btn btn--icon text-current tap-target js-remove-item"
                  href="{{ item.url_to_remove }}"
                  data-index="{{ item.index | plus: 1 }}"
                  aria-label="{{- 'cart.items.remove' | t -}}"
                  {% if settings.preload_links %}
                    data-no-instant
                  {% endif %}
                >
                  {% render 'icon-trash' %}
                </a>
                <div class="cart-item__total price{% if settings.sale_price_color_card %} price--sale-color{% endif %}">
                  {%- if variant_price_reduced or item.original_line_price != item.final_line_price -%}
                    <dl class="cart-item__price m-0 flex md:inline">
                      <dt class="visually-hidden">
                        {{- 'products.product.price.sale_price' | t -}}
                      </dt>
                      <dd class="price__current m-0 font-bold{% if is_drawer %} inline-block{% endif %}">
                        {%- render 'price-as-money', price: item.final_line_price, show_money_with_currency: false -%}
                      </dd>
                      <dt class="visually-hidden">
                        {{- 'products.product.price.regular_price' | t -}}
                      </dt>
                      <dd class="m-0{% if is_drawer %} inline-block{% endif %}">
                        {%- if variant_price_reduced -%}
                          <s class="price__was{% if settings.superscript_decimals %} price__was--supercents{% endif %}">
                            {%- liquid
                              assign compare_at_total_price = item.variant.compare_at_price | times: item.quantity
                              render 'price-as-money', price: compare_at_total_price, show_money_with_currency: false
                            -%}
                          </s>
                        {%- else -%}
                          <s class="price__was{% if settings.superscript_decimals %} price__was--supercents{% endif %}">
                            {%- render 'price-as-money',
                              price: item.original_line_price,
                              show_money_with_currency: false
                            -%}
                          </s>
                        {%- endif -%}
                      </dd>
                    </dl>
                  {%- else -%}
                    <strong class="price__current">
                      {%- render 'price-as-money', price: item.original_line_price, show_money_with_currency: false -%}
                    </strong>
                  {%- endif -%}
                </div>
                <div class="cart-item__loader relative is-loading" hidden></div>
              </div>
              <div
                class="alert mt-6 bg-error-bg text-error-text cart-item__error"
                id="line-item-error-{{ item.index | plus: 1 }}"
                role="alert"
                hidden
              ></div>
            </td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  {%- endif -%}

  <p class="visually-hidden" id="cart-live-region-text" role="status" aria-live="polite">
    {{ 'cart.summary.subtotal' | t }}:
    {%- render 'price-as-money', price: cart.total_price, show_money_with_currency: true -%}
  </p>
  <p class="visually-hidden" id="cart-line-item-status" role="status" aria-live="polite" aria-hidden="true">
    {{- 'accessibility.loading' | t -}}
  </p>

  {%- if is_drawer -%}
    <div class="alert mt-6 bg-error-bg text-error-text" id="cart-errors" role="alert" hidden></div>
  {%- endif -%}
</cart-items>
