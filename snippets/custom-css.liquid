{% if template.name == 'collection' and template.suffix == 'signature' %}
<style>
  /* === Signature Collection — dark theme. Only loads on collection.signature template === */

  /* Body bg covers gaps between header/main/footer — header & footer have their own bg so they're unaffected */
  body { background-color: #212020 !important; }

  #main-content, #main-content .shopify-section { background-color: #212020; }

  #main-content h1, #main-content h2, #main-content h3,
  #main-content h4, #main-content h5, #main-content h6,
  #main-content p, #main-content span, #main-content li,
  #main-content label, #main-content td, #main-content th { color: #ffffff; }

  #main-content a { color: #ffffff; }
  #main-content a:hover { color: rgba(255,255,255,0.75); }

  #main-content .breadcrumbs,
  #main-content .breadcrumbs a,
  #main-content .breadcrumbs span { color: #ffffff; }

  /* Toolbar */
  #main-content .products-toolbar { background-color: transparent; border-color: rgba(255,255,255,0.15); }
  #main-content .products-toolbar__filter-btn { color: #ffffff; }
  #main-content .products-toolbar__sort label { color: #ffffff; }
  #main-content hr { border-color: rgba(255,255,255,0.12); }

  /* Filter sidebar */
  #main-content .main-products-grid__filters,
  #main-content .facets, #main-content .drawer__content,
  #main-content .drawer__header, #main-content .disclosure__panel,
  #main-content .facets__filters { background-color: #2a2929; color: #ffffff; }
  #main-content .filter__toggle, #main-content .filter__label,
  #main-content .active-filter, #main-content .active-filters-header,
  #main-content .disclosure__toggle, #main-content .link { color: #ffffff; }
  #main-content .filter__count { color: rgba(255,255,255,0.55); }
  #main-content .checkbox::before { border-color: rgba(255,255,255,0.4); }
  #main-content input[type="text"], #main-content input[type="number"] {
    background-color: #2a2929; color: #ffffff; border-color: rgba(255,255,255,0.3);
  }

  /* Product cards */
  #main-content .card, #main-content .card--product,
  #main-content .card__info-container, #main-content .card__info,
  #main-content .card__info-inner {
    background-color: #2a2929 !important; border-color: rgba(255,255,255,0.08) !important;
  }
  #main-content .card__title, #main-content .card-link, #main-content .card__vendor,
  #main-content .card__subtitle, #main-content .card__weight { color: #ffffff !important; }
  #main-content .text-theme-light { color: rgba(255,255,255,0.6) !important; }
  #main-content .price, #main-content .price__regular, #main-content .price__sale,
  #main-content .price-item, #main-content [class*="price"] { color: #ffffff !important; }

  /* Shop Now / Add to Cart — theme uses background shorthand with gradient, must override with background not background-color */
  #main-content .btn.btn--primary,
  #main-content .btn--atc {
    background: #ffffff !important;
    color: #000000 !important;
    border-color: #ffffff !important;
  }
  #main-content .btn.btn--primary:hover,
  #main-content .btn--atc:hover {
    background: #000000 !important;
    color: #ffffff !important;
    border-color: #000000 !important;
  }
  /* Force spans inside buttons to inherit button color, not the global white span rule */
  #main-content .btn span { color: inherit !important; }

  /* Secondary / view button */
  #main-content .btn.btn--secondary,
  #main-content .quick-add-view-btn {
    background: transparent !important;
    border-color: #ffffff !important;
    color: #ffffff !important;
  }
  #main-content .btn.btn--secondary:hover,
  #main-content .quick-add-view-btn:hover {
    background: #ffffff !important;
    color: #000000 !important;
  }

  /* Sort dropdown — listbox bg is light (from theme global bg vars), but our li/span rules force white
     text, causing invisible options. Override listbox to dark bg so white text is readable. */
  #main-content .products-toolbar__sort .custom-select__btn {
    background: transparent !important;
  }
  #main-content .products-toolbar__sort .custom-select__btn span { color: #ffffff !important; }
  #main-content .products-toolbar__sort .custom-select__listbox {
    background: #2a2929 !important;
    color: #ffffff !important;
    border-color: rgba(255,255,255,0.25) !important;
  }
  #main-content .products-toolbar__sort .custom-select__option { color: #ffffff !important; }
  #main-content .products-toolbar__sort .custom-select__option.is-focused {
    background: rgba(255,255,255,0.12) !important;
    color: #ffffff !important;
  }

  /* Price range filter inputs — white bg, black text */
  #main-content .price-range .input,
  #main-content .price-range__input-wrapper .input {
    background-color: #ffffff !important;
    color: #000000 !important;
    border-color: #cccccc !important;
  }
  #main-content .price-range__currency { color: #ffffff; }

  /* Section headings */
  #main-content .section__heading,
  #main-content [class*="section__title"] { color: #ffffff; }

  /* Pagination */
  #main-content .pagination a,
  #main-content .pagination span { color: #ffffff; border-color: rgba(255,255,255,0.3); }
  #main-content .pagination__item--current { background-color: #a70a10; border-color: #a70a10; }
</style>
{% endif %}

