/* ===== Empty Cart Design ===== */
.mls-ec {
  width: 100%;
  display: flex;
  flex-direction: column;
  background: #fff;
  padding-bottom: 24px;
}
.mls-ec__hero {
  padding: 32px 20px 24px;
  text-align: center;
  border-bottom: 1px solid #f2f2f2;
}
.mls-ec__hero-icon {
  width: 64px; height: 64px;
  background: #fff0f1;
  border: 2px solid #ffd0d2;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 14px;
  font-size: 26px;
}
.mls-ec__hero-title {
  font-size: 1.15em;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 6px;
  line-height: 1.3;
}
.mls-ec__hero-sub {
  font-size: 0.8em;
  color: #888;
  margin: 0;
  line-height: 1.5;
}
/* Section */
.mls-ec__section {
  padding: 18px 16px 0;
}
.mls-ec__section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.mls-ec__section-title {
  font-size: 0.62em;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #a70a10;
}
/* Nav buttons */
.mls-ec__nav {
  display: flex;
  gap: 6px;
}
.mls-ec__nav-btn {
  width: 28px; height: 28px;
  border-radius: 50%;
  border: 1.5px solid #ddd;
  background: #fff;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  color: #333;
  transition: border-color 0.2s, background 0.2s, color 0.2s;
  padding: 0;
}
.mls-ec__nav-btn:hover:not(:disabled) {
  border-color: #a70a10;
  background: #a70a10;
  color: #fff;
}
.mls-ec__nav-btn:disabled {
  opacity: 0.35;
  cursor: default;
}
/* Category grid */
.mls-ec__cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}
.mls-ec__cat-card {
  border-radius: 10px;
  overflow: hidden;
  text-decoration: none;
  background: #fafafa;
  border: 1px solid #ededed;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
}
.mls-ec__cat-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(167,10,16,0.12);
  border-color: #ffc5c7;
}
.mls-ec__cat-img-wrap {
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  background: linear-gradient(135deg, #ffeaeb, #ffe0e1);
  display: flex; align-items: center; justify-content: center;
}
.mls-ec__cat-img-wrap img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}
.mls-ec__cat-fallback { font-size: 26px; }
.mls-ec__cat-name {
  font-size: 0.62em;
  font-weight: 600;
  color: #222;
  padding: 7px 4px 8px;
  line-height: 1.3;
  text-align: center;
  width: 100%;
}
/* Product slider */
.mls-ec__slider-wrap {
  overflow: hidden;
}
.mls-ec__slider-track {
  display: flex;
  gap: 10px;
  transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
  will-change: transform;
}
.mls-ec__prod-card {
  flex: 0 0 calc(50% - 5px);
  border-radius: 10px;
  border: 1px solid #ededed;
  background: #fafafa;
  overflow: hidden;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.2s;
}
.mls-ec__prod-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.1); }
.mls-ec__prod-img-wrap {
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  background: #f5f5f5;
  display: flex; align-items: center; justify-content: center;
}
.mls-ec__prod-img-wrap img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}
.mls-ec__prod-fallback { font-size: 24px; }
.mls-ec__prod-body {
  padding: 8px 9px 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}
.mls-ec__prod-name {
  font-size: 0.62em;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: 0;
}
.mls-ec__prod-price {
  font-size: 0.7em;
  font-weight: 700;
  color: #a70a10;
  margin: 0;
}
/* Dots */
.mls-ec__dots {
  display: flex;
  justify-content: center;
  gap: 6px;
  padding-top: 12px;
}
.mls-ec__dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #ddd;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
}
.mls-ec__dot.is-active {
  background: #a70a10;
  transform: scale(1.3);
}
/* CTA */
.mls-ec__cta-wrap {
  padding: 20px 16px 0;
}
.mls-ec__cta {
  display: block;
  width: 100%;
  background: #a70a10 !important;
  color: #fff !important;
  border-color: #a70a10 !important;
  font-size: 0.88em;
  font-weight: 700;
  padding: 13px 20px;
  border-radius: 8px;
  text-decoration: none;
  text-align: center;
  letter-spacing: 0.03em;
  transition: background 0.2s;
}
.mls-ec__cta:hover {
  background: #8c0a0f !important;
  border-color: #8c0a0f !important;
  color: #fff !important;
}
</style>

{% if template.name == 'collection' and template.suffix == 'signature' %}
<style>
  /* === Signature Collection — dark theme. Only loads on collection.signature template === */

  /* Body bg covers gaps between header/main/footer — header & footer have their own bg so they're unaffected */
  body { background-color: #212020 !important; }

  #main-content, #main-content .shopify-section { background-color: #212020; }

  #main-content h1, #main-content h2, #main-content h3,
