/* ===== Empty Cart Design ===== */
.mls-cart-empty {
  width: 100%;
  padding: 0 0 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  text-align: center;
  background: #fff;
}
/* Hero — white with red accent ring */
.mls-cart-empty__hero {
  background: #fff;
  border-bottom: 1px solid #f0f0f0;
  padding: 28px 20px 22px;
  width: 100%;
}
.mls-cart-empty__icon-wrap {
  width: 68px; height: 68px;
  background: #fff0f1;
  border: 2px solid #ffd0d2;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 14px;
  font-size: 28px;
}
.mls-cart-empty__hero-title {
  font-size: 1.2em;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 5px;
  line-height: 1.3;
}
.mls-cart-empty__hero-sub {
  font-size: 0.82em;
  color: #777;
  margin: 0;
  line-height: 1.4;
}
/* Section blocks */
.mls-cart-empty__block {
  width: 100%;
  padding: 18px 16px 0;
}
.mls-cart-empty__block-title {
  font-size: 0.65em;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #a70a10;
  text-align: left;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.mls-cart-empty__block-title::after {
  content: '';
  flex: 1;
  height: 1px;
  background: #f0f0f0;
}
/* Collection grid */
.mls-cart-empty__coll-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}
.mls-cart-empty__coll-card {
  border-radius: 10px;
  overflow: hidden;
  text-decoration: none;
  background: #fafafa;
  border: 1px solid #ededed;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s, box-shadow 0.2s;
}
.mls-cart-empty__coll-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(167,10,16,0.14);
  border-color: #ffc5c7;
}
.mls-cart-empty__coll-img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  display: block;
}
.mls-cart-empty__coll-placeholder {
  width: 100%;
  aspect-ratio: 1;
  background: linear-gradient(135deg, #ffeaeb, #ffe0e1);
  display: flex; align-items: center; justify-content: center;
  font-size: 28px;
}
.mls-cart-empty__coll-name {
  font-size: 0.65em;
  font-weight: 600;
  color: #222;
  padding: 8px 5px 9px;
  line-height: 1.3;
  text-align: center;
  width: 100%;
}
/* Product slide */
.mls-cart-empty__prod-scroll {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 4px;
}
.mls-cart-empty__prod-scroll::-webkit-scrollbar { height: 3px; }
.mls-cart-empty__prod-scroll::-webkit-scrollbar-track { background: #f5f5f5; border-radius: 2px; }
.mls-cart-empty__prod-scroll::-webkit-scrollbar-thumb { background: #ddd; border-radius: 2px; }
.mls-cart-empty__prod-card {
  flex: 0 0 110px;
  scroll-snap-align: start;
  border-radius: 10px;
  border: 1px solid #ededed;
  background: #fafafa;
  overflow: hidden;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s, box-shadow 0.2s;
}
.mls-cart-empty__prod-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 14px rgba(0,0,0,0.1);
}
.mls-cart-empty__prod-img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  display: block;
}
.mls-cart-empty__prod-placeholder {
  width: 100%;
  aspect-ratio: 1;
  background: linear-gradient(135deg, #f5f5f5, #ebebeb);
  display: flex; align-items: center; justify-content: center;
  font-size: 22px;
}
.mls-cart-empty__prod-info {
  padding: 7px 7px 8px;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.mls-cart-empty__prod-name {
  font-size: 0.6em;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.mls-cart-empty__prod-price {
  font-size: 0.6em;
  font-weight: 700;
  color: #a70a10;
}
/* Perks strip */
.mls-cart-empty__perks {
  width: 100%;
  padding: 16px 16px 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
}
.mls-cart-empty__perk {
  background: #fff8f4;
  border: 1px solid #fde8e0;
  border-radius: 10px;
  padding: 11px 5px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
}
.mls-cart-empty__perk-icon { font-size: 18px; line-height: 1; }
.mls-cart-empty__perk-text {
  font-size: 0.58em;
  font-weight: 600;
  color: #444;
  line-height: 1.3;
  text-align: center;
}
/* CTA */
.mls-cart-empty__cta-wrap {
  width: 100%;
  padding: 18px 16px 0;
}
.mls-cart-empty__cta {
  width: 100%;
  background: #a70a10 !important;
  color: #fff !important;
  border-color: #a70a10 !important;
  font-size: 0.9em;
  font-weight: 700;
  padding: 13px 20px;
  border-radius: 8px;
  text-decoration: none;
  display: block;
  text-align: center;
  transition: background 0.2s, transform 0.15s;
  letter-spacing: 0.02em;
}
.mls-cart-empty__cta:hover {
  background: #8a0810 !important;
  border-color: #8a0810 !important;
  color: #fff !important;
  transform: translateY(-1px);
}
</style>

