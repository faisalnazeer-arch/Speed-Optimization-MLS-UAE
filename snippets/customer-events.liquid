function heatmapLoadConversionSnippet(url) {
  var script = document.createElement("script"); script.type = "text/javascript";
  script.src = url; script.async = false; script.defer = true; document.head.appendChild(script);
}
heatmapLoadConversionSnippet("https://dashboard.heatmap.com/conversions.js?siteId=2040");

analytics.subscribe('checkout_completed', async (event) => {
  const data = event.data.checkout;
  async function glocalStore(key) {
    try {
      return Promise.resolve(browser.localStorage.getItem(key));
    } catch (error) {}
  }
  const payload = {
    idorder: data.order.id,
    revenue: data.totalPrice.amount,
    products: JSON.stringify(data.lineItems),
    currency: data.currencyCode,
    _idv: await glocalStore('_heatVid'),
    _id: await glocalStore('_mr_vid'),
    idsite: 2040,
    quicktransaction: 1,
    device_type: await glocalStore('_heatDeviceType'),
  };
  fetch('https://dashboard.heatmap.com/heatmap.php?siteId=2040', {
      method: 'POST',
      body: JSON.stringify(payload),
      keepalive: true,
  });
});
</script>