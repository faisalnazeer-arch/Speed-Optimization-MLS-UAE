<script>
  let map, marker, autocomplete, domObserver;
  const LS_KEY = "submitted_location";
  let pacFixInterval;
  let currentPinCoords = null; // ✅ Track pin position independently

  function setCookie(name, value, days) {
    const d = new Date();
    d.setTime(d.getTime() + days * 86400000);
    document.cookie = `${name}=${encodeURIComponent(value)};expires=${d.toUTCString()};path=/`;
  }

  function getCookie(name) {
    const match = document.cookie.match(new RegExp("(^| )" + name + "=([^;]+)"));
    return match ? decodeURIComponent(match[2]) : "";
  }

  function displayCoords(coords) {
    const el = document.getElementById("coords");
    if (el) el.innerHTML = `📍 <strong>${coords}</strong>`;
  }

  function toggleButtons(saved) {
    const getBtn = document.getElementById("get-location");
    const updateBtn = document.getElementById("update-location");
    if (getBtn) getBtn.style.display = saved ? "none" : "inline-block";
    if (updateBtn) updateBtn.style.display = saved ? "inline-block" : "none";
  }

  function saveCoords(coords) {
    if (!coords) return;
    currentPinCoords = coords; // ✅ Always keep this in sync
    localStorage.setItem(LS_KEY, coords);
    setCookie("customer_location", coords, 1);
    displayCoords(coords);
    toggleButtons(true);

    fetch("/cart/update.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ attributes: { customer_location: coords } })
    }).catch(e => console.log("Cart update:", e));
  }

  function destroyMapInstances() {
    console.log("💥 Destroying all Google Maps instances");

    if (pacFixInterval) {
      clearInterval(pacFixInterval);
      pacFixInterval = null;
    }

    if (autocomplete) {
      try {
        google.maps.event.clearInstanceListeners(autocomplete);
        autocomplete = null;
      } catch (e) { console.log("Autocomplete destroy error:", e); }
    }

    if (marker) {
      try {
        marker.setMap(null);
        marker = null;
      } catch (e) { console.log("Marker destroy error:", e); }
    }

    if (map) {
      try {
        google.maps.event.clearInstanceListeners(map);
        map = null;
      } catch (e) { console.log("Map destroy error:", e); }
    }

    document.querySelectorAll('.pac-container').forEach(container => {
      if (container?.parentNode) container.parentNode.removeChild(container);
    });

    const mapEl = document.getElementById("map");
    if (mapEl) mapEl.innerHTML = '';

    console.log("✅ All instances destroyed");
  }

  function fixPacContainerPosition() {
    const input = document.getElementById("location-search");
    const dropdownWrapper = document.getElementById("location-dropdown-container");
    const pac = document.querySelector(".pac-container");

    if (!input || !dropdownWrapper || !pac) return;

    dropdownWrapper.style.position = "relative";
    dropdownWrapper.style.width = "100%";
    dropdownWrapper.style.zIndex = "99999";
    dropdownWrapper.style.pointerEvents = "auto";

    pac.style.position = "absolute";
    pac.style.top = "100%";
    pac.style.left = "0";
    pac.style.width = "100%";
    pac.style.zIndex = "99999";
    pac.style.pointerEvents = "auto";
    pac.style.boxSizing = "border-box";
    pac.style.maxHeight = "200px";
    pac.style.overflowY = "auto";

    if (!dropdownWrapper.contains(pac)) {
      dropdownWrapper.appendChild(pac);
    }
  }

  function setupAutocomplete() {
    console.log("🔄 setupAutocomplete() called");

    const input = document.getElementById("location-search");
    const dropdownWrapper = document.getElementById("location-dropdown-container");

    if (!input || !dropdownWrapper) {
      console.log("❌ Missing input or dropdown wrapper");
      return false;
    }
    if (!window.google || !google.maps || !google.maps.places) {
      console.log("❌ Google Maps places not loaded");
      return false;
    }

    if (autocomplete) {
      google.maps.event.clearInstanceListeners(autocomplete);
      autocomplete = null;
    }

    if (pacFixInterval) clearInterval(pacFixInterval);

    autocomplete = new google.maps.places.Autocomplete(input, {
      fields: ["geometry", "formatted_address", "name", "place_id"],
      types: ["geocode", "establishment"]
    });

    if (map) autocomplete.bindTo("bounds", map);

    input.addEventListener("focus", () => {
      setTimeout(() => fixPacContainerPosition(), 50);
      if (pacFixInterval) clearInterval(pacFixInterval);
      pacFixInterval = setInterval(() => fixPacContainerPosition(), 200);
    });

    input.addEventListener("input", () => {
      setTimeout(() => fixPacContainerPosition(), 50);
    });

    input.addEventListener("blur", () => {
      if (pacFixInterval) {
        clearInterval(pacFixInterval);
        pacFixInterval = null;
      }
    });

    window.addEventListener("resize", () => fixPacContainerPosition());

    autocomplete.addListener("place_changed", () => {
      const place = autocomplete.getPlace();

      if (!place.geometry || !place.geometry.location) {
        const geocoder = new google.maps.Geocoder();
        geocoder.geocode({ address: input.value }, (results, status) => {
          if (status === "OK" && results[0]) {
            const loc = results[0].geometry.location;
            map?.setCenter(loc);
            marker?.setPosition(loc);
            const coords = `${loc.lat().toFixed(6)},${loc.lng().toFixed(6)}`;
            currentPinCoords = coords; // ✅ Sync pin coords
            saveCoords(coords);
            input.value = results[0].formatted_address;
          }
        });
        return;
      }

      const loc = place.geometry.location;
      map?.setCenter(loc);
      marker?.setPosition(loc);
      const coords = `${loc.lat().toFixed(6)},${loc.lng().toFixed(6)}`;
      currentPinCoords = coords; // ✅ Sync pin coords
      saveCoords(coords);
      input.value = place.formatted_address || place.name;
    });

    console.log("✓ Autocomplete setup complete");
    return true;
  }

  function setupButtons() {
    console.log("🔄 setupButtons() called");

    const getBtn = document.getElementById("get-location");
    const updateBtn = document.getElementById("update-location");

    // ── Get My Current Location ──
    if (getBtn) {
      const newGetBtn = getBtn.cloneNode(true);
      getBtn.parentNode.replaceChild(newGetBtn, getBtn);

      newGetBtn.addEventListener("click", (e) => {
        e.preventDefault();
        console.log("📍 Get location clicked");

        if (!navigator.geolocation) return;

        newGetBtn.disabled = true;
        newGetBtn.textContent = "Fetching...";

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const c = { lat: pos.coords.latitude, lng: pos.coords.longitude };
            if (marker) marker.setPosition(c);
            if (map) map.setCenter(c);
            const coords = `${c.lat.toFixed(6)},${c.lng.toFixed(6)}`;
            currentPinCoords = coords; // ✅ Sync pin coords
            saveCoords(coords);
            newGetBtn.disabled = false;
            newGetBtn.textContent = "Get My Current Location";
            console.log("✅ GPS location fetched:", c);
          },
          (error) => {
            console.error("Geolocation error:", error);
            newGetBtn.disabled = false;
            newGetBtn.textContent = "Get My Current Location";
          },
          { enableHighAccuracy: true }
        );
      });
    }

    // ── Update Location ──
    // ✅ NOT cloned — uses currentPinCoords variable instead of reading marker
    // This prevents the cart drawer re-render from losing the dragged position
    if (updateBtn) {
      updateBtn.onclick = null; // Clear any old handler safely
      updateBtn.addEventListener("click", (e) => {
        e.preventDefault();
        console.log("📍 Update location clicked");

        // ✅ Read from our tracked variable, not the marker directly
        // This is safe even if drawer re-renders between drag and click
        const coordsToSave = currentPinCoords || (() => {
          if (marker) {
            const pos = marker.getPosition();
            return `${pos.lat().toFixed(6)},${pos.lng().toFixed(6)}`;
          }
          return null;
        })();

        if (coordsToSave) {
          saveCoords(coordsToSave);
          console.log("✅ Saved pin position:", coordsToSave);

          // Visual feedback
          updateBtn.textContent = "✓ Saved!";
          setTimeout(() => {
            updateBtn.textContent = "Update Location";
          }, 2000);
        }
      });
    }
  }

  function initializeCartMap() {
    console.log("🚀 initializeCartMap() called");

    const mapEl = document.getElementById("map");
    const input = document.getElementById("location-search");

    if (!mapEl || !input) {
      console.log("❌ Missing map or input element");
      return false;
    }

    if (!window.google || !google.maps) {
      console.log("❌ Google Maps not loaded");
      return false;
    }

    let center = { lat: 25.276987, lng: 55.296249 };
    const saved = localStorage.getItem(LS_KEY) || getCookie("customer_location");

    if (saved) {
      const [lat, lng] = saved.split(",").map(parseFloat);
      if (!isNaN(lat) && !isNaN(lng)) {
        center = { lat, lng };
        currentPinCoords = saved; // ✅ Restore saved coords on init
        console.log("✓ Using saved location:", center);
      }
    }

    try {
      map = new google.maps.Map(mapEl, {
        center: center,
        zoom: 15,
        gestureHandling: "greedy",
        streetViewControl: false,
        fullscreenControl: false
      });

      marker = new google.maps.Marker({
        position: center,
        map: map,
        draggable: true
      });

      // ✅ Update currentPinCoords live as user drags
      marker.addListener("drag", () => {
        const pos = marker.getPosition();
        currentPinCoords = `${pos.lat().toFixed(6)},${pos.lng().toFixed(6)}`;
        displayCoords(currentPinCoords); // Show live position while dragging
      });

      // ✅ Also auto-save on drag end for convenience
      marker.addListener("dragend", () => {
        const pos = marker.getPosition();
        currentPinCoords = `${pos.lat().toFixed(6)},${pos.lng().toFixed(6)}`;
        saveCoords(currentPinCoords);
        console.log("📌 Pin dragged to:", currentPinCoords);
      });

      // Click on map moves pin
      map.addListener("click", (e) => {
        marker.setPosition(e.latLng);
        currentPinCoords = `${e.latLng.lat().toFixed(6)},${e.latLng.lng().toFixed(6)}`;
        saveCoords(currentPinCoords);
      });

      displayCoords(`${center.lat.toFixed(6)},${center.lng.toFixed(6)}`);
      toggleButtons(!!saved);

      console.log("✓ Map listeners attached");
    } catch (e) {
      console.error("❌ Map creation error:", e);
      return false;
    }

    setupButtons();
    setupAutocomplete();

    console.log("✅ Map initialization complete");
    return true;
  }

  function safeInitCartMap() {
    {% comment %} console.log("\n📞 safeInitCartMap() called"); {% endcomment %}

    const mapEl = document.getElementById("map");
    const inputEl = document.getElementById("location-search");

    if (!mapEl || !inputEl) {
      {% comment %} console.log("⏳ DOM not ready, retrying in 200ms..."); {% endcomment %}
      setTimeout(safeInitCartMap, 200);
      return;
    }

    if (!window.google || !google.maps) {
      {% comment %} console.log("⏳ Google Maps not ready, retrying in 200ms..."); {% endcomment %}
      setTimeout(safeInitCartMap, 200);
      return;
    }

    if (!inputEl.isConnected) {
      {% comment %} console.log("⏳ Input not fully connected, retrying in 200ms..."); {% endcomment %}
      setTimeout(safeInitCartMap, 200);
      return;
    }

    {% comment %} console.log("✅ DOM is ready, initializing map"); {% endcomment %}
    destroyMapInstances();
    setTimeout(() => initializeCartMap(), 50);
  }

  function onGoogleMapsReady() {
    {% comment %} console.log("🟢 Google Maps API loaded"); {% endcomment %}
    safeInitCartMap();
  }

  window.safeInitCartMap = safeInitCartMap;
  window.onGoogleMapsReady = onGoogleMapsReady;

  {% comment %} console.log("📦 Cart map script loaded"); {% endcomment %}
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDtupPgEYF-K0wT6U8er0QOs52EEZwAY3U&libraries=places&callback=onGoogleMapsReady" async defer></script>