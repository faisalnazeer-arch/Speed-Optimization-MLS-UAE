  {%- if settings.social_custom_url != blank and icon != blank -%}
    {%- liquid
      unless icon_height
        assign icon_height = 24
      endunless
      assign icon_height = icon_height | times: 2
    -%}
    <li>
      <a
        class="social__link flex items-center justify-center"
        href="{{ settings.social_custom_url }}"
        target="_blank"
        rel="noopener"
        {% if icon.alt %}
          title="{{- 'general.social.follow_shop' | t: shop_name: shop.name, social_platform: icon.alt -}}"
        {% endif %}
      >
        {{ icon | image_url: height: icon_height | image_tag: loading: 'lazy' }}
        {% if icon.alt -%}
          <span class="visually-hidden">{{ icon.alt }}</span>
        {%- endif %}
      </a>
    </li>
