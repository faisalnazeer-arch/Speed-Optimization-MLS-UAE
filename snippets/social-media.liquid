{%- comment -%}
  Parameters:
  - class {String} - Custom class name(s) for the list element (optional).
  - icon {Object} - Custom icon object (optional).
  - icon_height {Number} - Custom icon height (optional, default is 24).

  Usage:
  {% render 'social-media',
    class: 'justify-center',
    icon: settings.social_custom_icon
    icon_height: 24
  %}
{%- endcomment -%}

{%- liquid
  if class
    assign class = class | prepend: ' '
  endif
-%}

<ul class="social inline-flex flex-wrap{{ class }}">
  {%- if settings.social_call_url != blank -%}
    <li>
      <a
        class="social__link flex items-center justify-center"
        href="{{ settings.social_call_url }}"
        target="_blank"
        rel="noopener"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="#ffffff">
          <path d="M391.1 351.1c-27.5 0-54.3-4.3-79.4-12.7-12.3-4.1-25.8-1-35 7.5l-46.5 35.1c-52.1-27.6-95.2-70.7-122.8-122.8l35.1-46.5c8.5-9.2 11.6-22.7 7.5-35-8.4-25.1-12.7-51.9-12.7-79.4 0-18.2-14.8-33-33-33H64C45.8 64 32 77.8 32 96c0 212.1 171.9 384 384 384 18.2 0 32-13.8 32-32v-62.3c0-18.2-14.8-33-33-33z"/>
        </svg>

        <span class="visually-hidden">Call</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_facebook_url != blank -%}
    <li>
      <a
        class="social__link flex items-center justify-center"
        href="{{ settings.social_facebook_url }}"
        target="_blank"
        rel="noopener"
        title="{{- 'general.social.follow_shop' | t: shop_name: shop.name, social_platform: 'Facebook' -}}"
      >
        {%- render 'icon-facebook' -%}
        <span class="visually-hidden">Facebook</span>
      </a>
    </li>
  {%- endif -%}

