        "custom_liquid_GTmPCV": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% comment %} Delivery Section - Dubai & Rest of UAE (Exact same as React version) {% endcomment %}\n\n<div class=\"delivery-section\" style=\"padding: 20px; background-color: #fff; border-radius: 12px; margin: 10px 0;\">\n  \n  <!-- Tabs -->\n  <div id=\"tabs-container\" style=\"display: flex; background-color: #f1f1f1; border-radius: 8px; padding: 4px; margin-bottom: 20px;\">\n    \n    <div id=\"tab-dubai\" \n         class=\"delivery-tab active\" \n         style=\"flex: 1; padding: 12px; text-align: center; border-radius: 6px; cursor: pointer; background-color: #ffffff;\">\n      <span style=\"font-weight: 600; font-size: 15px; color: #000000;\">Dubai</span>\n    </div>\n    \n    <div id=\"tab-rest\" \n         class=\"delivery-tab\" \n         style=\"flex: 1; padding: 12px; text-align: center; border-radius: 6px; cursor: pointer; background-color: #f1f1f1;\">\n      <span style=\"font-weight: 600; font-size: 15px; color: #666666;\">Rest of UAE</span>\n    </div>\n  </div>\n\n  <!-- ==================== DUBAI CONTENT ==================== -->\n  <div id=\"content-dubai\" class=\"delivery-content\">\n    <p style=\"font-size: 14.5px; color: #555; margin-bottom: 16px; line-height: 1.5;\">\n      We offer fast delivery in Dubai.\n    </p>\n\n    <div style=\"background-color: #f9f9f9; padding: 14px; border-radius: 8px; margin-bottom: 10px;\">\n      <div style=\"font-weight: 600; font-size: 14.5px; margin-bottom: 6px; color: #000;\">Delivery Time</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444;\">\n        Delivered within 2 hours between 11:00 AM and 8:30 PM daily.\n      </div>\n    </div>\n\n    <div style=\"background-color: #f9f9f9; padding: 14px; border-radius: 8px; margin-bottom: 10px;\">\n      <div style=\"font-weight: 600; font-size: 14.5px; margin-bottom: 6px; color: #000;\">Last Order Time</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444;\">\n        8:30 PM is our last order cutoff, all days of the week (until further notice).\n      </div>\n    </div>\n\n    <div style=\"background-color: #f9f9f9; padding: 14px; border-radius: 8px; margin-bottom: 10px;\">\n      <div style=\"font-weight: 600; font-size: 14.5px; margin-bottom: 6px; color: #000;\">Delivery Fee</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444;\">\n        No minimum order value. Standard delivery fee is 15 AED.\n      </div>\n    </div>\n\n    <div style=\"background-color: #f9f9f9; padding: 14px; border-radius: 8px; margin-bottom: 10px;\">\n      <div style=\"font-weight: 600; font-size: 14.5px; margin-bottom: 6px; color: #000;\">Tipping</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444;\">\n        There’s no need to tip your delivery driver — we pay a living wage that doesn’t depend on tips.\n      </div>\n    </div>\n\n    <!-- Returns & Satisfaction -->\n    <div style=\"margin-top: 24px; padding-top: 16px; border-top: 1px solid #eee;\">\n      <div style=\"font-weight: 600; font-size: 15.5px; margin-bottom: 8px; color: #000;\">Free Returns</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444; margin-bottom: 12px;\">\n        Subject to meeting the conditions set out in this Returns &amp; Exchanges section, we offer a \"no questions asked\" free returns policy which allows you to return delivered items to us for any reason up to 30 days from the delivery of your order, free of charge.\n      </div>\n\n      <div style=\"font-weight: 600; font-size: 15px; margin-bottom: 8px; color: #000;\">100% Satisfaction Policy</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444; margin-bottom: 12px;\">\n        We offer 100% satisfaction policy. Please WhatsApp us on our customer service number within 24 hours and we will fix your experience.\n      </div>\n\n      <div onclick=\"window.open('https://wa.me/971505165407', '_blank')\" \n           style=\"background-color: #25D366; padding: 12px 16px; border-radius: 8px; margin-top: 8px; cursor: pointer; text-align: center;\">\n        <span style=\"color: #ffffff; font-weight: 600; font-size: 14.5px;\">\n          💬 WhatsApp Us: +971 50 451 6403\n        </span>\n      </div>\n    </div>\n  </div>\n\n  <!-- ==================== REST OF UAE CONTENT ==================== -->\n  <div id=\"content-rest\" class=\"delivery-content\" style=\"display: none;\">\n    <p style=\"font-size: 14.5px; color: #555; margin-bottom: 16px; line-height: 1.5;\">\n      Delivery information for Abu Dhabi, Sharjah and other areas.\n    </p>\n\n    <div style=\"background-color: #f9f9f9; padding: 14px; border-radius: 8px; margin-bottom: 10px;\">\n      <div style=\"font-weight: 600; font-size: 14.5px; margin-bottom: 6px; color: #000;\">Abu Dhabi</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444;\">\n        Orders delivered in 3 hours window throughout the day between 11:00 AM and 8:30 PM daily.\n      </div>\n    </div>\n\n    <div style=\"background-color: #f9f9f9; padding: 14px; border-radius: 8px; margin-bottom: 10px;\">\n      <div style=\"font-weight: 600; font-size: 14.5px; margin-bottom: 6px; color: #000;\">Sharjah</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444; white-space: pre-line;\">\n        Orders confirmed by 1:00 PM are delivered the same-day between 4:00 PM and 10:00 PM.\n        Orders confirmed after 1:00 PM are delivered next day.\n      </div>\n    </div>\n\n    <div style=\"background-color: #f9f9f9; padding: 14px; border-radius: 8px; margin-bottom: 10px;\">\n      <div style=\"font-weight: 600; font-size: 14.5px; margin-bottom: 6px; color: #000;\">Last Order Time</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444;\">\n        8:30 PM is our last order cutoff, all days of the week (until further notice).\n      </div>\n    </div>\n\n    <div style=\"background-color: #f9f9f9; padding: 14px; border-radius: 8px; margin-bottom: 10px;\">\n      <div style=\"font-weight: 600; font-size: 14.5px; margin-bottom: 6px; color: #000;\">Delivery Fee</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444;\">\n        No minimum order value. Standard delivery fee is 15 AED.\n      </div>\n    </div>\n\n    <div style=\"background-color: #f9f9f9; padding: 14px; border-radius: 8px; margin-bottom: 10px;\">\n      <div style=\"font-weight: 600; font-size: 14.5px; margin-bottom: 6px; color: #000;\">Tipping</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444;\">\n        There’s no need to tip your delivery driver — we pay a living wage that doesn’t depend on tips.\n      </div>\n    </div>\n\n    <!-- Returns & Satisfaction (same as Dubai) -->\n    <div style=\"margin-top: 24px; padding-top: 16px; border-top: 1px solid #eee;\">\n      <div style=\"font-weight: 600; font-size: 15.5px; margin-bottom: 8px; color: #000;\">Free Returns</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444; margin-bottom: 12px;\">\n        Subject to meeting the conditions set out in this Returns &amp; Exchanges section, we offer a \"no questions asked\" free returns policy which allows you to return delivered items to us for any reason up to 30 days from the delivery of your order, free of charge.\n      </div>\n\n      <div style=\"font-weight: 600; font-size: 15px; margin-bottom: 8px; color: #000;\">100% Satisfaction Policy</div>\n      <div style=\"font-size: 13.8px; line-height: 1.5; color: #444; margin-bottom: 12px;\">\n        We offer 100% satisfaction policy. Please WhatsApp us on our customer service number within 24 hours and we will fix your experience.\n      </div>\n\n      <div onclick=\"window.open('https://wa.me/971505165407', '_blank')\" \n           style=\"background-color: #25D366; padding: 12px 16px; border-radius: 8px; margin-top: 8px; cursor: pointer; text-align: center;\">\n        <span style=\"color: #ffffff; font-weight: 600; font-size: 14.5px;\">\n          💬 WhatsApp Us: +971 50 451 6403\n        </span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    const tabDubai = document.getElementById('tab-dubai');\n    const tabRest = document.getElementById('tab-rest');\n    const contentDubai = document.getElementById('content-dubai');\n    const contentRest = document.getElementById('content-rest');\n\n    function switchTab(activeTab) {\n      if (activeTab === 'dubai') {\n        tabDubai.style.backgroundColor = '#ffffff';\n        tabDubai.querySelector('span').style.color = '#000000';\n        tabRest.style.backgroundColor = '#f1f1f1';\n        tabRest.querySelector('span').style.color = '#666666';\n        contentDubai.style.display = 'block';\n        contentRest.style.display = 'none';\n      } else {\n        tabRest.style.backgroundColor = '#ffffff';\n        tabRest.querySelector('span').style.color = '#000000';\n        tabDubai.style.backgroundColor = '#f1f1f1';\n        tabDubai.querySelector('span').style.color = '#666666';\n        contentDubai.style.display = 'none';\n        contentRest.style.display = 'block';\n      }\n    }\n\n    tabDubai.addEventListener('click', () => switchTab('dubai'));\n    tabRest.addEventListener('click', () => switchTab('rest'));\n  });\n</script>"
          }
        }
